---
/**
 * /gallery — Gallery Hub
 *
 * Lists all model galleries with cover image, title, scale, and image count.
 * Each card links to /gallery/[slug].
 *
 * Data source: public/gallery/_index/models.json + per-model manifest.json
 * generated by scripts/update_manifest.py.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllGalleryEntries } from '../../lib/gallery';

const entries = getAllGalleryEntries();
---

<BaseLayout
  title="Gallery | Glushkov Modelling"
  description="Curated hi-res photo galleries for all scale model builds — rigging, hull, deck details and workshop views."
>
  <section class="page-section">
    <div class="container">
      <span class="eyebrow">Visual Archive</span>
      <h1 class="section-title">Model Gallery</h1>
      <p class="gallery-hub-lead">
        Selected hi-res photographs for each build, arranged by model.
        Click a card to open the full gallery with detailed viewer.
      </p>

      {entries.length > 0 ? (
        <div class="gallery-hub-grid">
          {entries.map((entry) => {
            const coverSrc = entry.cover?.paths.lowRes ?? entry.cover?.paths.hiRes ?? null;
            const coverAlt = entry.cover?.alt ?? entry.title;
            return (
              <a href={`/gallery/${entry.slug}`} class="gallery-hub-card" aria-label={`Open gallery: ${entry.title}`}>
                <div class="gallery-hub-cover">
                  {coverSrc ? (
                    <img
                      src={coverSrc}
                      alt={coverAlt}
                      loading="lazy"
                      width={entry.cover?.width}
                      height={entry.cover?.height}
                    />
                  ) : (
                    <div class="gallery-hub-cover-empty" aria-hidden="true">
                      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                        <rect x="3" y="3" width="18" height="18" rx="3"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <path d="m21 15-5-5L5 21"/>
                      </svg>
                    </div>
                  )}
                </div>
                <div class="gallery-hub-body">
                  <p class="eyebrow">{entry.scale}</p>
                  <h2 class="gallery-hub-title">{entry.title}</h2>
                  <p class="gallery-hub-count">{entry.imageCount} {entry.imageCount === 1 ? 'photograph' : 'photographs'}</p>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="gallery-hub-empty">
          <p>No galleries yet. Add model folders to <code>public/gallery/</code> and run <code>scripts/update_manifest.py &lt;folder&gt;</code>.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .gallery-hub-lead {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.72;
    margin-bottom: 28px;
    max-width: 60ch;
  }

  .gallery-hub-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .gallery-hub-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .gallery-hub-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }
  .gallery-hub-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .gallery-hub-cover {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface-offset);
  }
  .gallery-hub-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .gallery-hub-card:hover .gallery-hub-cover img {
    transform: scale(1.04);
  }
  .gallery-hub-cover-empty {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--color-text-faint);
  }

  .gallery-hub-body {
    padding: 18px 20px 20px;
  }
  .gallery-hub-body .eyebrow {
    margin-bottom: 6px;
  }
  .gallery-hub-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.85rem;
    line-height: 1.05;
    margin: 0 0 8px;
  }
  .gallery-hub-count {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    margin: 0;
  }

  .gallery-hub-empty {
    padding: 40px 32px;
    border: 1px dashed var(--color-primary-highlight);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    text-align: center;
  }
  .gallery-hub-empty code {
    font-size: 0.85em;
    background: var(--color-surface-offset);
    padding: 2px 6px;
    border-radius: 4px;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .gallery-hub-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .gallery-hub-grid { grid-template-columns: 1fr; }
  }
</style>
