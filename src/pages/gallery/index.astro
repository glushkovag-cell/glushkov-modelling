---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoHead from '../../components/seo/SeoHead.astro';
import GalleryFilters from '../../components/GalleryFilters.astro';
import {
  getAllGalleryEntries,
  getGalleryFilterIndexes,
} from '../../lib/gallery';
import { getAllNews, hasFreshNews } from '../../lib/wordpress';

const [entries, indexes, allNews] = await Promise.all([
  getAllGalleryEntries(),
  getGalleryFilterIndexes(),
  getAllNews(),
]);

const newsFlag = hasFreshNews(allNews);

/** Cover of the "All Photos" card, stored in the repository. */
const ALL_PHOTOS_COVER = '/images/gallery/all-photos.webp';

/**
 * M in the "N of M" summary: total number of photos in the photo index.
 */
const totalPhotos = Object.keys(indexes.photos.items).length;

/** Photos per tag for the popular-tags block of the filter panel. */
const tagPhotoCounts = Object.fromEntries(
    Object.entries(indexes.photos.byTag).map(([slug, keys]) => [slug, keys.length]),
);

/**
 * Scale on cards must match index values (trimmed, lower-cased in gallery.ts).
 */
function getCardScale(slug: string, rawScale: string): string {
  return (
      indexes.models.items[slug]?.scale ??
      String(rawScale ?? '').trim().toLowerCase()
  );
}

/**
 * Embedded build-time index. "<" is escaped so the JSON cannot close
 * the script element.
 */
const embeddedIndex = JSON.stringify({
  models: indexes.models,
  photos: indexes.photos,
}).replace(/</g, '\\u003c');
---

<BaseLayout
    title="Gallery | Glushkov Modelling"
    description="Curated hi-res photo galleries for all scale model builds — rigging, hull, deck details and workshop views."
    hasFreshNews={newsFlag}
>
  <SeoHead
      slot="head"
      pageType="default"
      title="Gallery | Glushkov Modelling"
      description="Curated hi-res photo galleries for all scale model builds — rigging, hull, deck details and workshop views."
      canonicalPath="/gallery"
      breadcrumbs={[{ name: 'Gallery', url: '/gallery' }]}
  />

  <section class="gallery-page page-section" data-gallery-hub>
    <div class="container">
      <div class="page-header">
        <span class="eyebrow">Visual Archive</span>
        <h1 class="section-title">Model Gallery</h1>
        <p class="gallery-hub-lead">
          Selected hi-res photographs for each build, arranged by model.
          Filter by historical period, scale and tags, then open a full gallery
          or browse all matching photos at once.
        </p>
      </div>

      {entries.length > 0 ? (
          <div class="content-layout">
            <GalleryFilters
                index={indexes.models}
                tagPhotoCounts={tagPhotoCounts}
                idPrefix="gallery"
                action="/gallery"
                heading="Filters"
            />

            <div class="gallery-main">
              <h2 class="gallery-visually-hidden" id="gallery-results-heading">
                Gallery results
              </h2>

              <div class="active-filters">
                <p
                    class="filter-count"
                    data-gallery-summary
                    role="status"
                    aria-live="polite"
                    aria-atomic="true"
                >
                  {totalPhotos} of {totalPhotos} photos
                </p>
              </div>

              <div
                  class="gallery-hub-grid"
                  data-gallery-grid
                  aria-labelledby="gallery-results-heading"
              >
                <article
                    class="gallery-hub-card gallery-hub-card--all build-card"
                    data-gallery-all-card
                >
                  <a
                      href="/gallery/all"
                      class="gallery-hub-card__link"
                      data-gallery-link
                      data-gallery-path="/gallery/all"
                      aria-label="Open all photos"
                  >
                    <div class="gallery-hub-cover gallery-hub-cover--all">
                      <div class="gallery-hub-cover-empty" aria-hidden="true">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="7" y="7" width="14" height="14" rx="2" />
                          <path d="M3 17V5a2 2 0 0 1 2-2h12" />
                          <circle cx="11.5" cy="11.5" r="1.5" />
                          <path d="m21 17-4-4-6 6" />
                        </svg>
                      </div>

                      <!--
                        Decorative cover: the card title "All Photos" already names it.
                        If the file fails to load, the image is hidden and the icon
                        underneath stays visible.
                      -->
                      <img
                          src={ALL_PHOTOS_COVER}
                          alt=""
                          width="1600"
                          height="1200"
                          decoding="async"
                          data-all-photos-cover
                          class="build-card-image gallery-hub-cover__image"
                      />
                    </div>

                    <div class="gallery-hub-body build-card-body">
                      <p class="eyebrow">All models</p>
                      <h3 class="gallery-hub-title">All Photos</h3>
                      <p class="gallery-hub-count" data-gallery-all-count>
                        {totalPhotos} {totalPhotos === 1 ? 'photograph' : 'photographs'}
                      </p>
                    </div>
                  </a>
                </article>

                {entries.map((entry) => {
                  const coverSrc = entry.cover?.paths.lowRes ?? entry.cover?.paths.hiRes ?? null;
                  const coverAlt = entry.cover?.alt ?? entry.title;

                  return (
                      <article
                          class="gallery-hub-card build-card"
                          data-gallery-card
                          data-slug={entry.slug}
                          data-period={entry.period}
                          data-scale={getCardScale(entry.slug, entry.scale)}
                      >
                        <a
                            href={`/gallery/${entry.slug}?returnTo=${encodeURIComponent('/gallery')}`}
                            class="gallery-hub-card__link"
                            data-gallery-link
                            data-gallery-path={`/gallery/${entry.slug}`}
                            aria-label={`Open gallery: ${entry.title}`}
                        >
                          <div class="gallery-hub-cover">
                            {coverSrc ? (
                                <img
                                    src={coverSrc}
                                    alt={coverAlt}
                                    loading="lazy"
                                    width={entry.cover?.width}
                                    height={entry.cover?.height}
                                    class="build-card-image"
                                />
                            ) : (
                                <div class="gallery-hub-cover-empty" aria-hidden="true">
                                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                                    <rect x="3" y="3" width="18" height="18" rx="3" />
                                    <circle cx="8.5" cy="8.5" r="1.5" />
                                    <path d="m21 15-5-5L5 21" />
                                  </svg>
                                </div>
                            )}
                          </div>

                          <div class="gallery-hub-body build-card-body">
                            <p class="eyebrow">{entry.scale}</p>
                            <h3 class="gallery-hub-title">{entry.title}</h3>
                            <p
                                class="gallery-hub-count"
                                data-gallery-card-count
                                data-total={entry.imageCount}
                            >
                              {entry.imageCount} {entry.imageCount === 1 ? 'photograph' : 'photographs'}
                            </p>
                          </div>
                        </a>
                      </article>
                  );
                })}
              </div>

              <div class="gallery-hub-empty card-surface" data-gallery-empty hidden>
                <p>No photos match these filters.</p>
                <button
                    type="button"
                    class="gallery-hub-empty__reset"
                    data-gallery-empty-reset
                >
                  Reset filters
                </button>
              </div>
            </div>
          </div>
      ) : (
          <div class="gallery-hub-empty">
            <p>No galleries available yet. Check CMS gallery index or publish model manifests.</p>
          </div>
      )}
    </div>
  </section>

  {entries.length > 0 && (
      <script
          is:inline
          type="application/json"
          id="gallery-filter-index"
          set:html={embeddedIndex}
          />
  )}
</BaseLayout>

<script>
  import type {
    GalleryFilterIndex,
  } from '../../lib/gallery';
  import {
    computeResult,
    createEmptyFilterState,
    getTotalResultCount,
    isGalleryFilterIndex,
    parseUrl,
    toQuery,
    updateFilterQuery,
    type FilterGroup,
    type FilterState,
  } from '../../scripts/galleryFilterEngine';

  interface HubIndexes {
    models: GalleryFilterIndex;
    photos: GalleryFilterIndex;
  }

  const FILTER_GROUPS: FilterGroup[] = ['period', 'scale', 'tag'];

  function pluralize(count: number, one: string, many: string): string {
    return `${count} ${count === 1 ? one : many}`;
  }

  /**
   * Reads the embedded index. Missing or malformed JSON returns null,
   * and the page keeps showing all cards.
   */
  function readIndexes(): HubIndexes | null {
    const element = document.getElementById('gallery-filter-index');
    if (!element?.textContent) return null;

    try {
      const data = JSON.parse(element.textContent) as Partial<HubIndexes>;

      if (
          isGalleryFilterIndex(data.models) &&
          isGalleryFilterIndex(data.photos)
      ) {
        return { models: data.models, photos: data.photos };
      }
    } catch {
      /* Malformed JSON: fall through to null. */
    }

    console.warn('[gallery] filter index is missing or malformed; showing all galleries');
    return null;
  }

  /**
   * Builds the value → label map used in the summary line.
   */
  function createLabelMap(index: GalleryFilterIndex): Map<string, string> {
    const labels = new Map<string, string>();

    for (const option of index.periods) labels.set(`period:${option.value}`, option.label);
    for (const option of index.scales) labels.set(`scale:${option.value}`, option.label);

    for (const group of index.groups) {
      for (const tag of group.tags) labels.set(`tag:${tag.slug}`, tag.name);
    }

    return labels;
  }

  function describeState(state: FilterState, labels: Map<string, string>): string {
    const titles: Record<FilterGroup, string> = {
      period: 'Period',
      scale: 'Scale',
      tag: 'Tags',
    };

    return FILTER_GROUPS
        .filter((group) => state[group].length > 0)
        .map((group) => {
          const values = state[group].map(
              (value) => labels.get(`${group}:${value}`) ?? value,
          );

          return `${titles[group]}: ${values.join(', ')}`;
        })
        .join(' · ');
  }

  function hasActiveFilters(state: FilterState): boolean {
    return FILTER_GROUPS.some((group) => state[group].length > 0);
  }

  function initGalleryHub(): void {
    const root = document.querySelector<HTMLElement>('[data-gallery-hub]');
    if (!root || root.dataset.filtersInitialized === 'true') return;

    const form = root.querySelector<HTMLFormElement>('[data-gallery-filter-form]');
    const grid = root.querySelector<HTMLElement>('[data-gallery-grid]');
    const summary = root.querySelector<HTMLElement>('[data-gallery-summary]');
    const emptyState = root.querySelector<HTMLElement>('[data-gallery-empty]');
    const allCard = root.querySelector<HTMLElement>('[data-gallery-all-card]');
    const allCount = root.querySelector<HTMLElement>('[data-gallery-all-count]');
    const mobileSummary = root.querySelector<HTMLElement>('.gallery-filters__mobile-summary');

    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-gallery-card]'));
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-gallery-link]'));
    const resetButtons = Array.from(
        root.querySelectorAll<HTMLButtonElement>(
            '[data-gallery-filter-reset], [data-gallery-empty-reset]',
        ),
    );

    if (!form || !grid || !summary || !emptyState) return;

    const indexes = readIndexes();

    /* No usable index: leave server-rendered state (all cards visible). */
    if (!indexes) return;

    root.dataset.filtersInitialized = 'true';

    const labels = createLabelMap(indexes.models);
    const totalPhotos = getTotalResultCount(indexes.photos);
    const defaultMobileSummary =
        mobileSummary?.textContent?.trim() || 'Browse by period, scale and tags';

    /** Photos per model, used for "N of M photographs" on each card. */
    const photosPerModel = new Map<string, number>();
    for (const item of Object.values(indexes.photos.items)) {
      photosPerModel.set(item.model, (photosPerModel.get(item.model) ?? 0) + 1);
    }

    function getInputs(): HTMLInputElement[] {
      return Array.from(
          form!.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'),
      );
    }

    function readStateFromInputs(): FilterState {
      const state = createEmptyFilterState();

      for (const input of getInputs()) {
        if (!input.checked) continue;

        const group = input.name as FilterGroup;
        if (FILTER_GROUPS.includes(group)) state[group].push(input.value);
      }

      return state;
    }

    function writeStateToInputs(state: FilterState): void {
      for (const input of getInputs()) {
        const group = input.name as FilterGroup;

        input.checked =
            FILTER_GROUPS.includes(group) && state[group].includes(input.value);
      }
    }

    function updateChipStates(): void {
      for (const input of getInputs()) {
        const chip = input.closest<HTMLElement>('.gallery-filter-chip');
        if (!chip) continue;

        chip.dataset.selected = input.checked ? 'true' : 'false';
        chip.classList.toggle('is-selected', input.checked);
      }
    }

    /**
     * Writes only period, scale and tag into the address bar.
     * The obsolete count parameter is dropped by updateFilterQuery.
     */
    function updateUrl(state: FilterState): void {
      const query = updateFilterQuery(window.location.search, state);
      const nextUrl = `${window.location.pathname}${query}${window.location.hash}`;

      window.history.replaceState(window.history.state, '', nextUrl);
    }

    /**
     * Passes the current filters to /gallery/all and /gallery/[slug]
     * together with returnTo, which [slug].astro uses for its back link.
     */
    function updateLinks(state: FilterState): void {
      const filterQuery = toQuery(state);
      const returnTo = `/gallery${filterQuery}`;

      for (const link of links) {
        const path = link.dataset.galleryPath;
        if (!path) continue;

        const params = new URLSearchParams(filterQuery);
        params.set('returnTo', returnTo);

        link.href = `${path}?${params.toString()}`;
      }
    }

    function updateCards(state: FilterState, matchingPhotoKeys: string[]): number {
      const visibleModels = new Set(computeResult(indexes!.models, state));
      const filtered = hasActiveFilters(state);

      const matchedPerModel = new Map<string, number>();
      for (const key of matchingPhotoKeys) {
        const model = indexes!.photos.items[key]?.model;
        if (model) matchedPerModel.set(model, (matchedPerModel.get(model) ?? 0) + 1);
      }

      let visibleCount = 0;

      for (const card of cards) {
        const slug = card.dataset.slug ?? '';

        /*
         * A card is shown when the model matches and at least one of its
         * photos matches. Models missing from the index are shown only
         * without filters.
         */
        const isKnown = slug in indexes!.models.items;
        const matched = matchedPerModel.get(slug) ?? 0;
        const visible = isKnown
            ? visibleModels.has(slug) && matched > 0
            : !filtered;

        card.hidden = !visible;
        if (visible) visibleCount += 1;

        const countElement = card.querySelector<HTMLElement>('[data-gallery-card-count]');
        if (countElement && isKnown) {
          const total = photosPerModel.get(slug) ?? Number(countElement.dataset.total ?? 0);

          countElement.textContent = filtered
              ? `${matched} of ${pluralize(total, 'photograph', 'photographs')}`
              : pluralize(total, 'photograph', 'photographs');
        }
      }

      return visibleCount;
    }

    function updateSummary(state: FilterState, matchedPhotos: number): void {
      const description = describeState(state, labels);
      const result = `${matchedPhotos} of ${pluralize(totalPhotos, 'photo', 'photos')}`;

      summary!.textContent = description ? `${result} · ${description}` : result;

      if (mobileSummary) {
        const selected = FILTER_GROUPS.reduce(
            (sum, group) => sum + state[group].length,
            0,
        );

        mobileSummary.textContent = selected > 0
            ? `${pluralize(selected, 'filter', 'filters')} selected · ${result}`
            : defaultMobileSummary;
      }
    }

    function applyFilters({ syncUrl = true } = {}): void {
      const state = readStateFromInputs();
      const matchingPhotoKeys = computeResult(indexes!.photos, state);
      const matchedPhotos = matchingPhotoKeys.length;

      updateChipStates();
      if (syncUrl) updateUrl(state);
      updateLinks(state);

      const visibleModels = updateCards(state, matchingPhotoKeys);

      if (allCard) allCard.hidden = matchedPhotos === 0;
      if (allCount) allCount.textContent = pluralize(matchedPhotos, 'photograph', 'photographs');

      const nothingFound = matchedPhotos === 0 || visibleModels === 0;
      grid!.hidden = nothingFound;
      emptyState!.hidden = !nothingFound;

      updateSummary(state, matchedPhotos);

      /* Lets GalleryFilters sync Reset and the full tag list. */
      form!.dispatchEvent(new CustomEvent('gallery-filters:state'));
    }

    form.addEventListener('change', () => applyFilters());

    /* Filtering is client-only: never submit the form to the server. */
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      applyFilters();
    });

    for (const button of resetButtons) {
      button.addEventListener('click', () => {
        writeStateToInputs(createEmptyFilterState());
        applyFilters();
      });
    }

    /*
     * Restore state from URL. Unknown values and obsolete parameters
     * such as count are ignored by parseUrl.
     */
    writeStateToInputs(parseUrl(indexes.models, window.location.search));
    applyFilters({ syncUrl: false });
  }

  /**
   * Hides the All Photos cover if the file fails to load, so the
   * icon underneath stays visible instead of a broken-image glyph.
   * The image may fail before this module runs, hence the check of
   * complete/naturalWidth in addition to the error listener.
   */
  function initAllPhotosCover(): void {
    const cover = document.querySelector<HTMLImageElement>('[data-all-photos-cover]');
    if (!cover) return;

    const hide = () => {
      cover.hidden = true;
    };

    if (cover.complete && cover.naturalWidth === 0) {
      hide();
      return;
    }

    cover.addEventListener('error', hide, { once: true });
  }

  initAllPhotosCover();
  initGalleryHub();
  document.addEventListener('astro:page-load', () => {
    initAllPhotosCover();
    initGalleryHub();
  });
</script>

<style is:global>
  .gallery-page {
    padding: 2.5rem 0 3rem;
  }

  .page-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .gallery-hub-lead {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.72;
    margin: 0 auto;
    max-width: 60ch;
  }

  .gallery-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    border: 0;
    white-space: nowrap;
  }

  .content-layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .gallery-main {
    min-width: 0;
  }

  .active-filters {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .filter-count {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .gallery-hub-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .gallery-hub-grid[hidden],
  .gallery-hub-card[hidden] {
    display: none;
  }

  .gallery-hub-card {
    height: 100%;
  }

  .gallery-hub-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .gallery-hub-card__link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .gallery-hub-cover {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface-offset);
  }

  .gallery-hub-cover--all {
    position: relative;
    background: var(--color-primary-highlight);
  }

  .gallery-hub-cover--all .gallery-hub-cover__image {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .gallery-hub-cover--all .gallery-hub-cover__image[hidden] {
    display: none;
  }

  .gallery-hub-cover--all .gallery-hub-cover-empty {
    color: var(--color-primary);
  }

  .gallery-hub-cover-empty {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--color-text-faint);
  }

  .gallery-hub-body .eyebrow {
    margin-bottom: 6px;
  }

  .gallery-hub-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.85rem;
    line-height: 1.05;
    margin: 0 0 8px;
  }

  .gallery-hub-count {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    margin: 0;
  }

  .gallery-hub-empty {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: 40px 32px;
    border: 1px dashed var(--color-primary-highlight);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    text-align: center;
  }

  .gallery-hub-empty[hidden] {
    display: none;
  }

  .gallery-hub-empty p {
    margin: 0;
  }

  .gallery-hub-empty__reset {
    min-width: 44px;
    min-height: 44px;
    padding: 0.625rem 1.25rem;
    border: 1px solid var(--color-primary);
    border-radius: 999px;
    background: transparent;
    color: var(--color-primary);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition:
        background-color 180ms ease,
        color 180ms ease;
  }

  .gallery-hub-empty__reset:hover {
    background: var(--color-primary-highlight);
    color: var(--color-primary-hover);
  }

  .gallery-hub-empty__reset:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .gallery-hub-empty code {
    font-size: 0.85em;
    background: var(--color-surface-offset);
    padding: 2px 6px;
    border-radius: 4px;
    white-space: nowrap;
  }

  @media (max-width: 1024px) {
    .content-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .gallery-hub-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .gallery-page {
      padding: 1.5rem 0 2rem;
    }

    .page-header {
      margin-bottom: 1.5rem;
      text-align: left;
    }

    .content-layout {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .active-filters {
      margin-bottom: 1rem;
    }

    .filter-count {
      font-size: 0.8125rem;
    }

    .gallery-hub-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .gallery-hub-card {
      border-radius: 0.75rem;
    }

    .gallery-hub-title {
      font-size: 1.35rem;
      line-height: 1.15;
    }

    .gallery-hub-count {
      font-size: 0.8125rem;
    }

    .gallery-hub-empty {
      padding: 1.5rem 1rem;
      border-radius: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-hub-empty__reset {
      transition: none;
    }
  }
</style>
