---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoHead from '../../components/seo/SeoHead.astro';
import {
    getTutorialBySlug,
    getAllNews,
    hasFreshNews,
} from '../../lib/wordpress';

const { slug } = Astro.params;

if (!slug) {
    return Astro.redirect('/tutorials');
}

const tutorial = await getTutorialBySlug(slug);

if (!tutorial) {
    return Astro.redirect('/tutorials');
}

const allNews = await getAllNews();
const newsFlag = hasFreshNews(allNews);

const returnToParam = Astro.url.searchParams.get('returnTo');
const backToTutorialsHref =
    returnToParam && returnToParam.startsWith('/tutorials')
        ? returnToParam
        : '/tutorials';
---

<BaseLayout title={tutorial.title} hasFreshNews={newsFlag}>
    <SeoHead
            slot="head"
            pageType="article"
            title={`${tutorial.title} — Tutorials`}
            description={tutorial.teaser || tutorial.title}
            canonicalPath={`/tutorials/${tutorial.slug}`}
            breadcrumbs={[
                { name: 'Tutorials', url: '/tutorials' },
                { name: tutorial.title, url: `/tutorials/${tutorial.slug}` },
            ]}
    />

    <article class="tutorial-detail">
        <div class="container">
            <a
                    class="detail-back-btn"
                    id="backToTutorialsBtn"
                    href={backToTutorialsHref}
            >
                <span class="detail-back-icon">←</span>
                <span>Back to tutorials</span>
            </a>

            <header class="tutorial-detail__header">
                <h1>{tutorial.title}</h1>

                {tutorial.teaser && (
                        <p class="tutorial-detail__teaser">{tutorial.teaser}</p>
                )}
            </header>

            {tutorial.featuredImage?.sourceUrl && (
                    <div class="tutorial-detail__media">
                        <img
                                src={tutorial.featuredImage.sourceUrl}
                                alt={tutorial.featuredImage.altText || tutorial.title}
                                loading="eager"
                                width="1200"
                                height="700"
                        />
                    </div>
            )}

            <div class="tutorial-detail__content">
                <Fragment set:html={tutorial.content} />
            </div>
        </div>
    </article>
</BaseLayout>

<style is:global>
    .detail-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        color: var(--color-primary);
        text-decoration: none;
        font-weight: 600;
    }

    .detail-back-btn:hover {
        color: var(--color-primary-hover);
    }

    .detail-back-icon {
        line-height: 1;
    }

    .tutorial-detail {
        padding: 3rem 0;
    }

    .tutorial-detail__header {
        margin-bottom: 1.5rem;
    }

    .tutorial-detail__header h1 {
        margin: 0 0 1rem;
    }

    .tutorial-detail__teaser {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 1.125rem;
        line-height: 1.6;
    }

    .tutorial-detail__media {
        margin-bottom: 2rem;
    }

    .tutorial-detail__media img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 1rem;
    }

    .tutorial-detail__content {
        min-width: 0;
    }
</style>
