---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsStrip from '../components/news/NewsStrip.astro';
import { getAllModels, getAllNews, getFreshNews, hasFreshNews } from '../lib/wordpress';
import SeoHead from '../components/seo/SeoHead.astro';

const allModels = await getAllModels();
const allNews = await getAllNews();
const freshNews = getFreshNews(allNews).slice(0, 3);
const newsFlag = hasFreshNews(allNews);
const showNewsSection = freshNews.length > 0;

// featured builds: только completed / in_progress, сортировка по modelinfo.donedate (по убыванию)
const featuredBuilds = allModels
    .filter((model: any) => {
      const status = model.buildstatusClass;
      const done = model.modelinfo?.donedate;
      return (status === 'completed' || status === 'in_progress') && !!done;
    })
    .sort((a: any, b: any) => {
      const aTime = new Date(a.modelinfo.donedate).getTime();
      const bTime = new Date(b.modelinfo.donedate).getTime();
      return bTime - aTime;
    })
    .slice(0, 3);

const socialLinks = [
  {
    title: 'Telegram',
    description: 'Quick updates, workshop notes, and work-in-progress fragments.',
    href: 'https://t.me/glushkov_modelling',
  },
  {
    title: 'YouTube',
    description: 'Longer-form videos focused on builds, process, and presentation.',
    href: 'https://youtube.com/@glushkov-modelling',
  },
  {
    title: 'Instagram',
    description: 'Selected visuals, close details, and photographed moments from the bench.',
    href: 'https://www.instagram.com/glushkovag',
  },
  {
    title: 'Facebook',
    description: 'Published posts, project updates, and a broader social archive.',
    href: 'https://www.facebook.com/share/17zLdeZUCw/?mibextid=wwXIfr',
  },
];
const SEO_TITLE = 'Glushkov Modelling — Wooden Ship Model Build Logs & Tutorials';
const SEO_DESCRIPTION = 'A curated archive of historically researched wooden sailing ship models from the 18th–19th centuries. Build logs and workshop notes by Andrey Glushkov.';
---


<BaseLayout title={SEO_TITLE} description={SEO_DESCRIPTION} hasFreshNews={newsFlag}>
    <SeoHead slot="head" pageType="home" title={SEO_TITLE} description={SEO_DESCRIPTION} />
  <!-- HERO -->
  <section class="hero" id="top">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-card hero-copy">
          <span class="eyebrow">Virtual Shipyard</span>
          <h1>Glushkov Modelling</h1>
          <p>
            A curated archive of historically researched ship models, build logs, and workshop notes focused on wooden
            sailing vessels of the 18th and 19th centuries.
          </p>

          <div class="hero-meta">
            <a href="/builds" class="meta-pill">Explore Builds</a>
            <a href="/about" class="meta-pill">About the Builder</a>
            <a href="/ai-hub" class="meta-pill">AI Hub</a>
          </div>

          <div class="hero-meta" style="margin-top: 12px;">
            {showNewsSection && <a href="#news" class="nav-link-light">News</a>}
            <a href="#featured-builds" class="nav-link-light">Featured Builds</a>
            <a href="#about" class="nav-link-light">About</a>
            <a href="#social-hub" class="nav-link-light">Social Hub</a>
          </div>
        </div>

        <div class="hero-card hero-image">
          <img
              src="https://cms.glushkov-modelling.com/wordpress/wp-content/uploads/2026/04/A59F363E-B30F-4B6B-BE14-E6F9BB1873FA_1_105_c-e1776070135300.jpeg"
              alt="Workshop bench — model ship building in progress"
          />
        </div>
      </div>
    </div>
  </section>

  <span id="news" aria-hidden="true"></span>

  <!-- NEWS -->
  {showNewsSection && (
      <section class="page-section page-section--news">
        <div class="container">
          <div class="news-band">
            <div class="news-band__inner">
              <span class="eyebrow">News</span>
              <NewsStrip items={freshNews} />
            </div>
          </div>
        </div>
      </section>
  )}

  <!-- FEATURED BUILDS -->
  <section class="page-section page-section--featured" id="featured-builds">
    <div class="container">
      <div
        style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px;"
      >
        <div>
          <span class="eyebrow">Featured Builds</span>
          <h2 class="section-title" style="margin: 0;">Three current directions</h2>
          <p style="color: var(--color-text-muted); margin-top: 8px;">
            The site is currently centered around three major projects, each with its own pace, material logic, and
            visual character.
          </p>
        </div>

        <a href="#top" class="nav-link-light" style="flex-shrink: 0; margin-left: 24px;">↑ Top</a>
      </div>

      <div class="builds-grid">
        {featuredBuilds.map((model: any) => (
          <a
            href={`/builds/${model.slug}`}
            class="build-card"
            aria-label={`Open build log: ${model.title}`}
          >
            {model.modelinfo?.modelimageurl && (
              <img
                src={model.modelinfo.modelimageurl}
                alt={model.heroImageAlt || model.title}
                loading="lazy"
                class="build-card-image"
              />
            )}

            <div class="build-card-body">
              {model.buildstatusText && (
                <span
                  class={`meta-pill status-${model.buildstatusClass}`}
                  style="margin-bottom: 12px; display: inline-flex;"
                >
                  {model.buildstatusText}
                </span>
              )}

              <span class="eyebrow">
                {model.modelinfo?.modelscale || '—'} · {model.modelinfo?.manufacturer || '—'}
              </span>

              <h2>{model.title}</h2>

              <p>
                {model.modelinfo?.shortdescription ||
                  'A documented build focused on structure, materials, historical character, and the evolving logic of the model as the work progresses.'}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="page-section" id="about">
    <div class="container">
      <div class="section-grid section-grid--equal">
        <div class="content-card">
          <span class="eyebrow">About</span>
          <h2 class="card-title">A workshop built around process, patience, and detail</h2>
          <div class="content-html">
            <p>
              GLUSHKOV MODELLING brings together long-form build logs, selected photography, and notes from the
              workbench. The focus is not only on finished models, but on the process itself — structure, materials,
              historical character, and the small decisions that shape each stage.
            </p>
          </div>
          <a href="/about" class="build-link" style="margin-top: 8px; display: inline-block;">Read About →</a>
        </div>

        <div class="content-card">
          <span class="eyebrow">Navigation</span>
          <div class="spec-grid" style="margin-top: 8px;">
            <div class="spec-item" style="grid-column: 1 / -1;">
              <span class="spec-label">Build Logs</span>
              <span class="spec-value">
                <a href="/builds" style="color: var(--color-primary);">All builds →</a>
              </span>
            </div>

            {featuredBuilds.map((model: any) => (
              <div class="spec-item" style="grid-column: 1 / -1;">
                <span class="spec-label">{model.title}</span>
                <span class="spec-value">
                  <a href={`/builds/${model.slug}`} style="color: var(--color-primary);">
                    Open log →
                  </a>
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SOCIAL HUB -->
  <section class="page-section" id="social-hub">
    <div class="container">
      <div
        style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px;"
      >
        <div>
          <span class="eyebrow">Social Hub</span>
          <h2 class="section-title" style="margin: 0;">Follow the work as it develops</h2>
          <p style="color: var(--color-text-muted); margin-top: 8px;">
            Different platforms serve different parts of the process — quick progress notes, longer videos, selected
            images, and published updates.
          </p>
        </div>

        <a href="#top" class="nav-link-light" style="flex-shrink: 0; margin-left: 24px;">↑ Top</a>
      </div>

      <div class="builds-grid">
        {socialLinks.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="build-card"
            aria-label={`Open ${item.title}`}
          >
            <div class="build-card-body">
              <h2>{item.title}</h2>
              <p>{item.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nav-link-light {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--color-text-muted);
    opacity: 0.7;
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 3px 10px;
    background: transparent;
    transition: color 0.15s, border-color 0.15s, opacity 0.15s;
    white-space: nowrap;
  }

  .nav-link-light:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    opacity: 1;
  }

  .page-section--news {
    padding-top: 0;
    padding-bottom: 8px;
  }

  .news-band {
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--color-primary) 38%, var(--color-border));
    border-radius: 20px;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-primary) 6%, var(--color-surface)) 0%,
        var(--color-surface) 100%
      );
    box-shadow:
      0 8px 22px rgba(0, 0, 0, 0.035),
      0 0 0 1px color-mix(in srgb, var(--color-primary) 10%, transparent) inset;
    overflow: hidden;
  }

  .news-band::before {
    content: '';
    display: block;
    height: 3px;
    width: 100%;
    background: var(--color-primary);
    opacity: 0.95;
  }

  .news-band__inner {
    padding: 10px 22px 10px;
  }

  .page-section--featured {
    padding-top: 20px;
  }

  @media (min-width: 900px) {
    .page-section--news {
      padding-top: 0;
      padding-bottom: 2px;
    }

    .news-band__inner {
      padding: 10px 26px 10px;
    }

    .page-section--featured {
      padding-top: 14px;
    }
  }
</style>