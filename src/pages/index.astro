---
import BaseLayout from '../layouts/BaseLayout.astro';

const featuredBuilds = [
  {
    title: 'Le Requin',
    meta: '1750 French xebec',
    description:
      'An in-depth build focused on one of the most elegant Mediterranean warships of the eighteenth century. The project follows the model through structure, rigging, and the layered discipline of historical detail.',
    href: '/builds/le-requin',
  },
  {
    title: 'HMS Bounty',
    meta: '1:60 scale • Amati',
    description:
      'A detailed study of one of the most recognisable ships in maritime history. Hull work, deck elements, sails, and rigging are documented as the build moves forward.',
    href: '/builds/bounty',
  },
  {
    title: 'Blériot XI',
    meta: '1:10 scale • Amati',
    description:
      'A shift from naval subjects to early aviation, where exposed structure and mechanical lightness become part of the visual language. It broadens the workshop while keeping the same careful approach to craft and documentation.',
    href: '/builds/bleriot-xi',
  },
];

const socialLinks = [
  {
    title: 'Telegram',
    description: 'Quick updates, workshop notes, and work-in-progress fragments.',
    href: 'https://t.me/glushkov_modelling',
  },
  {
    title: 'YouTube',
    description: 'Longer-form videos focused on builds, process, and presentation.',
    href: 'https://youtube.com/@glushkov-modelling',
  },
  {
    title: 'Instagram',
    description: 'Selected visuals, close details, and photographed moments from the bench.',
    href: 'https://www.instagram.com/glushkovag',
  },
  {
    title: 'Facebook',
    description: 'Published posts, project updates, and a broader social archive.',
    href: 'https://www.facebook.com/share/17zLdeZUCw/?mibextid=wwXIfr',
  },
];
---

<BaseLayout title="Glushkov Modelling">

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-card hero-copy">
          <span class="eyebrow">Virtual Shipyard</span>
          <h1>Glushkov Modelling</h1>
          <p>A curated archive of historically researched ship models, build logs, and workshop notes focused on wooden sailing vessels of the 18th and 19th centuries.</p>
          <div class="hero-meta">
            <a href="/builds" class="meta-pill">Explore Builds</a>
            <a href="/about" class="meta-pill meta-pill--outline">About the Builder</a>
          </div>
        </div>
        <div class="hero-card hero-image">
          <img
            src="http://glushkov-modelling.synzilla.local/wordpress/wp-content/uploads/2026/04/A59F363E-B30F-4B6B-BE14-E6F9BB1873FA_1_105_c.jpeg"
            alt="Workshop bench — model ship building in progress"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED BUILDS -->
  <section class="page-section">
    <div class="container">
      <span class="eyebrow">Featured Builds</span>
      <h2 class="section-title">Three current directions</h2>
      <p class="short-desc">The site is currently centered around three major projects, each with its own pace, material logic, and visual character.</p>
      <div class="builds-grid" style="margin-top: 28px;">
        {featuredBuilds.map((build) => (
          <article class="build-card">
            <div class="build-card-body">
              <p style="margin: 0 0 6px; font-size: 0.85rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.08em;">{build.meta}</p>
              <h2>{build.title}</h2>
              <p>{build.description}</p>
              <a href={build.href} class="build-link">View build log →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT TEASER -->
  <section class="page-section">
    <div class="container">
      <div class="section-grid">
        <div class="content-card">
          <span class="eyebrow">About</span>
          <h2 class="card-title">A workshop built around process, patience, and detail</h2>
          <p class="content-html">GLUSHKOV MODELLING brings together long-form build logs, selected photography, and notes from the workbench. The focus is not only on finished models, but on the process itself — structure, materials, historical character, and the small decisions that shape each stage.</p>
          <a href="/about" class="build-link">Read About →</a>
        </div>
        <div class="info-card">
          <span class="eyebrow">Navigation</span>
          <div class="spec-grid" style="margin-top: 8px;">
            <div class="spec-item" style="grid-column: 1 / -1;"><span class="spec-label">Build Logs</span><span class="spec-value"><a href="/builds" style="color: var(--color-primary);">All builds →</a></span></div>
            <div class="spec-item" style="grid-column: 1 / -1;"><span class="spec-label">Le Requin</span><span class="spec-value"><a href="/builds/le-requin" style="color: var(--color-primary);">Open log →</a></span></div>
            <div class="spec-item" style="grid-column: 1 / -1;"><span class="spec-label">HMS Bounty</span><span class="spec-value"><a href="/builds/bounty" style="color: var(--color-primary);">Open log →</a></span></div>
            <div class="spec-item" style="grid-column: 1 / -1;"><span class="spec-label">Blériot XI</span><span class="spec-value"><a href="/builds/bleriot-xi" style="color: var(--color-primary);">Open log →</a></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SOCIAL HUB -->
  <section class="page-section">
    <div class="container">
      <span class="eyebrow">Social Hub</span>
      <h2 class="section-title">Follow the work as it develops</h2>
      <p class="short-desc">Different platforms serve different parts of the process — quick progress notes, longer videos, selected images, and published updates.</p>
      <div class="builds-grid" style="margin-top: 28px; grid-template-columns: repeat(2, minmax(0, 1fr));">
        {socialLinks.map((item) => (
          <article class="build-card">
            <div class="build-card-body">
              <h2 style="font-size: 1.6rem;">{item.title}</h2>
              <p>{item.description}</p>
              <a href={item.href} class="build-link" target="_blank" rel="noopener">Open {item.title} →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .meta-pill--outline {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }
  .meta-pill--outline:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
</style>
