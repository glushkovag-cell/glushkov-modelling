---
import BaseLayout from '../layouts/BaseLayout.astro';

const featuredBuilds = [
  {
    title: 'Le Requin',
    meta: '1750 French xebec',
    description:
      'An in-depth build focused on one of the most elegant Mediterranean warships of the eighteenth century. The project follows the model through structure, rigging, and the layered discipline of historical detail.',
    href: '/builds/le-requin',
  },
  {
    title: 'HMS Bounty',
    meta: '1:60 scale \u2022 Amati',
    description:
      'A detailed study of one of the most recognisable ships in maritime history. Hull work, deck elements, sails, and rigging are documented as the build moves forward.',
    href: '/builds/bounty',
  },
  {
    title: 'Bl\u00e9riot XI',
    meta: '1:10 scale \u2022 Amati',
    description:
      'A shift from naval subjects to early aviation, where exposed structure and mechanical lightness become part of the visual language. It broadens the workshop while keeping the same careful approach to craft and documentation.',
    href: '/builds/bleriot-xi',
  },
];

const socialLinks = [
  {
    title: 'Telegram',
    description: 'Quick updates, workshop notes, and work-in-progress fragments.',
    href: 'https://t.me/glushkov_modelling',
  },
  {
    title: 'YouTube',
    description: 'Longer-form videos focused on builds, process, and presentation.',
    href: 'https://youtube.com/@glushkov-modelling',
  },
  {
    title: 'Instagram',
    description: 'Selected visuals, close details, and photographed moments from the bench.',
    href: 'https://www.instagram.com/glushkovag',
  },
  {
    title: 'Facebook',
    description: 'Published posts, project updates, and a broader social archive.',
    href: 'https://www.facebook.com/share/17zLdeZUCw/?mibextid=wwXIfr',
  },
];
---
<BaseLayout title="Glushkov Modelling">
  <!-- HERO -->
  <section class="hero" id="top">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-card hero-copy">
          <span class="eyebrow">Virtual Shipyard</span>
          <h1>Glushkov Modelling</h1>
          <p>A curated archive of historically researched ship models, build logs, and workshop notes focused on wooden sailing vessels of the 18th and 19th centuries.</p>
          <div class="hero-meta">
            <a href="/builds" class="meta-pill">Explore Builds</a>
            <a href="/about" class="meta-pill">About the Builder</a>
          </div>
          <!-- Quick navigation -->
          <div class="hero-meta" style="margin-top: 12px;">
            <a href="#featured-builds" class="nav-link-light">Featured Builds</a>
            <a href="#about" class="nav-link-light">About</a>
            <a href="#social-hub" class="nav-link-light">Social Hub</a>
          </div>
        </div>
        <div class="hero-card hero-image">
          <img src="https://cms.glushkov-modelling.com/wordpress/wp-content/uploads/2026/04/A59F363E-B30F-4B6B-BE14-E6F9BB1873FA_1_105_c-e1776070135300.jpeg" alt="Workshop bench &#8212; model ship building in progress" />
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED BUILDS -->
  <section class="page-section" id="featured-builds">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px;">
        <div>
          <span class="eyebrow">Featured Builds</span>
          <h2 class="section-title" style="margin: 0;">Three current directions</h2>
          <p style="color: var(--color-text-muted); margin-top: 8px;">The site is currently centered around three major projects, each with its own pace, material logic, and visual character.</p>
        </div>
        <a href="#top" class="nav-link-light" style="flex-shrink: 0; margin-left: 24px;">&#8593; Top</a>
      </div>
      <div class="builds-grid">
        {featuredBuilds.map((build) => (
          <div class="build-card">
            <div class="build-card-body">
              <span class="eyebrow">{build.meta}</span>
              <h2>{build.title}</h2>
              <p>{build.description}</p>
              <a href={build.href} class="build-link">View build log &#8594;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="page-section" id="about">
    <div class="container">
      <div class="section-grid section-grid--equal">
        <div class="content-card">
          <span class="eyebrow">About</span>
          <h2 class="card-title">A workshop built around process, patience, and detail</h2>
          <div class="content-html">
            <p>GLUSHKOV MODELLING brings together long-form build logs, selected photography, and notes from the workbench. The focus is not only on finished models, but on the process itself &#8212; structure, materials, historical character, and the small decisions that shape each stage.</p>
          </div>
          <a href="/about" class="build-link" style="margin-top: 8px; display: inline-block;">Read About &#8594;</a>
        </div>
        <div class="content-card">
          <span class="eyebrow">Navigation</span>
          <div class="spec-grid" style="margin-top: 8px;">
            <div class="spec-item" style="grid-column: 1 / -1;"><span class="spec-label">Build Logs</span><span class="spec-value"><a href="/builds" style="color: var(--color-primary);">All builds &#8594;</a></span></div>
            <div class="spec-item" style="grid-column: 1 / -1;"><span class="spec-label">Le Requin</span><span class="spec-value"><a href="/builds/le-requin" style="color: var(--color-primary);">Open log &#8594;</a></span></div>
            <div class="spec-item" style="grid-column: 1 / -1;"><span class="spec-label">HMS Bounty</span><span class="spec-value"><a href="/builds/bounty" style="color: var(--color-primary);">Open log &#8594;</a></span></div>
            <div class="spec-item" style="grid-column: 1 / -1;"><span class="spec-label">Bl&#233;riot XI</span><span class="spec-value"><a href="/builds/bleriot-xi" style="color: var(--color-primary);">Open log &#8594;</a></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SOCIAL HUB -->
  <section class="page-section" id="social-hub">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px;">
        <div>
          <span class="eyebrow">Social Hub</span>
          <h2 class="section-title" style="margin: 0;">Follow the work as it develops</h2>
          <p style="color: var(--color-text-muted); margin-top: 8px;">Different platforms serve different parts of the process &#8212; quick progress notes, longer videos, selected images, and published updates.</p>
        </div>
        <a href="#top" class="nav-link-light" style="flex-shrink: 0; margin-left: 24px;">&#8593; Top</a>
      </div>
      <div class="builds-grid">
        {socialLinks.map((item) => (
          <div class="build-card">
            <div class="build-card-body">
              <h2>{item.title}</h2>
              <p>{item.description}</p>
              <a href={item.href} target="_blank" rel="noopener" class="build-link">Open {item.title} &#8594;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nav-link-light {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--color-text-muted);
    opacity: 0.7;
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 3px 10px;
    background: transparent;
    transition: color 0.15s, border-color 0.15s, opacity 0.15s;
    white-space: nowrap;
  }
  .nav-link-light:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    opacity: 1;
  }
</style>
