---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoHead from '../components/seo/SeoHead.astro';
import { getAllNews, hasFreshNews } from '../lib/wordpress';

const allNews = await getAllNews();
const newsFlag = hasFreshNews(allNews);

const SEO_TITLE = 'About Andrey Glushkov — Scale Model Builder | Glushkov Modelling';
const SEO_DESCRIPTION = 'Andrey Glushkov is a master model builder specialising in wooden sailing vessels of the 18th–19th centuries. Build logs, rigging tutorials, and workshop notes from a dedicated scale modeller.';
---

<BaseLayout
    title={SEO_TITLE}
    description={SEO_DESCRIPTION}
    hasFreshNews={newsFlag}
>
  <SeoHead
    slot="head"
    pageType="about"
    title={SEO_TITLE}
    description={SEO_DESCRIPTION}
    breadcrumbs={[{ name: 'About', url: '/about' }]}
  />

  <!-- остальной контент страницы остаётся без изменений -->
  <slot />
</BaseLayout>
