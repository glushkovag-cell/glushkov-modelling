---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/tools.css';
import {
    SAIL_NODE_KINDS,
    defaultSettingsForProfile,
    type SailNodeKind,
} from '../../lib/rigging/settings.ts';
import { summariseProfile } from '../../lib/rigging/profiles.ts';
import { listProfileDocuments } from '../../lib/rigging/profileStore.ts';
import {
    MAST_IDS,
    MAST_LABELS,
    SAIL_CLASSES,
    SAIL_CLASS_LABELS,
    TIERS,
    TIER_LABELS,
} from '../../lib/rigging/profile.ts';

const documents = listProfileDocuments();
const entries = documents.map((document) => ({
    document,
    summary: summariseProfile(document),
    defaults: defaultSettingsForProfile(document),
}));

const initial = entries[0]!;
const defaults = initial.defaults;

const unitOptions = [
    { value: 'mm', label: 'mm' },
    { value: 'cm', label: 'cm' },
    { value: 'in', label: 'in' },
];

const basisOptions = [
    { value: 'model', label: 'The model' },
    { value: 'prototype', label: 'The full-size vessel' },
];

const pointOptions = [
    { value: 'partner', label: 'At the partner' },
    { value: 'maximum', label: 'Maximum diameter' },
    { value: 'step', label: 'At the step (proxy)' },
];

const mastOptions = MAST_IDS.map((mastId) => ({
    value: mastId,
    label: MAST_LABELS[mastId].en,
}));

const SAIL_NODE_LABELS: Record<SailNodeKind, string> = {
    main_sail: 'Mainsail',
    gaff: 'Gaff',
    gaff_sail: 'Gaff sail',
    boom: 'Boom',
    topsail: 'Topsail',
    head_lower: 'Lower headsail',
    head_upper: 'Upper headsail',
    staysail: 'Staysail',
    flag: 'Flag halyard',
};

function valueOrEmpty(value: number | null | undefined): string {
    return value === null || value === undefined ? '' : String(value);
}

const title = 'Rigging diameter calculator — Glushkov Modelling';
const description =
    'Estimate scale-model diameters of standing and running rigging from your model\u2019s key dimensions and an explicitly chosen rigging profile.';
---

<BaseLayout title={title} description={description} noindex>
  <section class="tools-page">
    <div class="container">
      <nav class="tools-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/tools">Tools</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Rigging diameter calculator</span>
      </nav>

      <header class="tools-head">
        <span class="eyebrow">Workshop tools</span>
        <h1>Rigging diameter calculator</h1>
        <p class="tools-lede">
          Estimated diameters for the main standing and running rigging of a
          static scale model, calculated only for the nodes supported by the
          chosen profile.
        </p>
      </header>

      <div class="rig-disclaimer" role="note">
        <strong>Estimates only — not historical data.</strong>{' '}
        Every value this calculator produces is an <strong>engineering estimate</strong>{' '}
        or a <strong>preliminary fit</strong>. None are documented historical
        dimensions: if you already have a source document with rigging sizes, use
        it directly. These figures are for a static model and must not be used for
        a full-size vessel.
      </div>

      <div class="tools-layout">
        <form class="rig-form" id="rigging-form" novalidate>
          <p class="rig-form__hint">
            Example values are prefilled — replace them with your model&rsquo;s
            dimensions. Results update only when you press{' '}
            <strong>Calculate diameters</strong>.
          </p>

          <div class="rig-form__errors" id="form-errors" role="alert" hidden></div>

          <fieldset class="rig-section">
            <legend class="rig-section__title">1 · Rigging profile</legend>

            <p class="rig-profile__context">
              The profile is chosen explicitly. The historical year or period does
              not select a profile; hover or select a card to read the full
              description.
            </p>

            <div class="rig-profiles" role="radiogroup" aria-label="Rigging profile">
              {entries.map((entry, index) => (
                <div
                  class="rig-profile"
                  data-profile-card
                  data-version={entry.summary.profileVersion}
                  data-ui={JSON.stringify(entry.summary.ui)}
                  data-defaults={JSON.stringify(entry.defaults)}
                >
                  <input
                    class="rig-profile__radio"
                    id={`profile-${entry.summary.profileId}`}
                    type="radio"
                    name="profile"
                    value={entry.summary.profileId}
                    checked={index === 0}
                  />
                  <label class="rig-profile__body" for={`profile-${entry.summary.profileId}`}>
                    <span class="rig-profile__head">
                      <strong>{entry.summary.name}</strong>
                      <span class="rig-profile__range">{entry.summary.family} · v{entry.summary.profileVersion}</span>
                      <span class="rig-profile__status">{entry.summary.status}</span>
                    </span>
                    <span class="rig-profile__details">
                      <span class="rig-profile__desc">{entry.summary.explanation.summary}</span>
                      <span class="rig-profile__note">{entry.summary.explanation.disclaimer}</span>
                      <span class="rig-profile__note">{entry.summary.explanation.taxonomy}</span>
                      {entry.summary.explanation.calibration && (
                        <span class="rig-profile__note">{entry.summary.explanation.calibration}</span>
                      )}
                      {entry.summary.explanation.accuracy && (
                        <span class="rig-profile__note">{entry.summary.explanation.accuracy}</span>
                      )}
                      {entry.summary.explanation.caveat && (
                        <span class="rig-profile__note">{entry.summary.explanation.caveat}</span>
                      )}
                    </span>
                  </label>
                  <details class="rig-profile__more">
                    <summary>Sources &amp; full caveats</summary>
                    <ul class="rig-profile__caveats">
                      {entry.summary.warnings.map((warning) => (
                        <li>{warning}</li>
                      ))}
                    </ul>
                    <p class="rig-profile__source">
                      Sources: {entry.document.profile.sources.map((source) => source.title).join(' · ')}
                    </p>
                  </details>
                </div>
              ))}
            </div>

            <p class="rig-profile__context" id="profile-context-note" role="status" aria-live="polite">
              Selected: {initial.summary.name} v{initial.summary.profileVersion} — {initial.summary.ruleCount} rule definitions. Draft profiles are not historical verification.
            </p>
          </fieldset>

          <fieldset class="rig-section">
            <legend class="rig-section__title">2 · Model scale &amp; dimensions</legend>

            <div class="rig-field rig-field--scale">
              <label class="rig-label" for="scale">Model scale</label>
              <div class="rig-scale">
                <span class="rig-scale__prefix">1 :</span>
                <input
                  class="rig-input"
                  id="scale"
                  name="scale"
                  type="number"
                  min="1"
                  step="any"
                  inputmode="decimal"
                  value={defaults.scaleDenominator}
                />
              </div>
            </div>

            <div class="rig-dims">
              <div class="rig-dims__head" aria-hidden="true">
                <span>Dimension</span>
                <span>Value</span>
                <span>Unit</span>
                <span>Measured on</span>
                <span>Point</span>
              </div>

              {MAST_IDS.map((mastId) => (
                <div class="rig-dim" data-dim={`mast-${mastId}`}>
                  <label class="rig-label" for={`mast-${mastId}-value`}>
                    {MAST_LABELS[mastId].en} diameter
                  </label>
                  <input
                    class="rig-input"
                    id={`mast-${mastId}-value`}
                    name={`mast-${mastId}-value`}
                    type="number"
                    min="0"
                    step="any"
                    inputmode="decimal"
                    value={valueOrEmpty(defaults.masts[mastId].diameter.value)}
                  />
                  <select class="rig-select" id={`mast-${mastId}-unit`} name={`mast-${mastId}-unit`}>
                    {unitOptions.map((option) => (
                      <option value={option.value} selected={defaults.masts[mastId].diameter.unitId === option.value}>
                        {option.label}
                      </option>
                    ))}
                  </select>
                  <select class="rig-select" id={`mast-${mastId}-basis`} name={`mast-${mastId}-basis`}>
                    {basisOptions.map((option) => (
                      <option value={option.value} selected={defaults.masts[mastId].diameter.basis === option.value}>
                        {option.label}
                      </option>
                    ))}
                  </select>
                  <select class="rig-select" id={`mast-${mastId}-point`} name={`mast-${mastId}-point`}>
                    {pointOptions.map((option) => (
                      <option value={option.value} selected={defaults.masts[mastId].diameter.measurementPointId === option.value}>
                        {option.label}
                      </option>
                    ))}
                  </select>
                </div>
              ))}

              <div class="rig-dim" data-dim="bowsprit">
                <label class="rig-label" for="bowsprit-value">Bowsprit diameter</label>
                <input
                  class="rig-input"
                  id="bowsprit-value"
                  name="bowsprit-value"
                  type="number"
                  min="0"
                  step="any"
                  inputmode="decimal"
                  value={valueOrEmpty(defaults.bowsprit.diameter.value)}
                />
                <select class="rig-select" id="bowsprit-unit" name="bowsprit-unit">
                  {unitOptions.map((option) => (
                    <option value={option.value} selected={defaults.bowsprit.diameter.unitId === option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
                <select class="rig-select" id="bowsprit-basis" name="bowsprit-basis">
                  {basisOptions.map((option) => (
                    <option value={option.value} selected={defaults.bowsprit.diameter.basis === option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
                <span class="rig-dim__empty">—</span>
              </div>

              <div class="rig-dim" data-dim="hull-width">
                <label class="rig-label" for="hull-width-value">Maximum hull width</label>
                <input
                  class="rig-input"
                  id="hull-width-value"
                  name="hull-width-value"
                  type="number"
                  min="0"
                  step="any"
                  inputmode="decimal"
                  value={valueOrEmpty(defaults.hullWidth.value)}
                />
                <select class="rig-select" id="hull-width-unit" name="hull-width-unit">
                  {unitOptions.map((option) => (
                    <option value={option.value} selected={defaults.hullWidth.unitId === option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
                <select class="rig-select" id="hull-width-basis" name="hull-width-basis">
                  {basisOptions.map((option) => (
                    <option value={option.value} selected={defaults.hullWidth.basis === option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
                <span class="rig-dim__empty">—</span>
              </div>

              <div class="rig-dim" data-dim="gun-bore">
                <label class="rig-label" for="gun-bore-value">Gun bore diameter</label>
                <input
                  class="rig-input"
                  id="gun-bore-value"
                  name="gun-bore-value"
                  type="number"
                  min="0"
                  step="any"
                  inputmode="decimal"
                  value={valueOrEmpty(defaults.gun.bore.value)}
                />
                <select class="rig-select" id="gun-bore-unit" name="gun-bore-unit">
                  {unitOptions.map((option) => (
                    <option value={option.value} selected={defaults.gun.bore.unitId === option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
                <select class="rig-select" id="gun-bore-basis" name="gun-bore-basis">
                  {basisOptions.map((option) => (
                    <option value={option.value} selected={defaults.gun.bore.basis === option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
                <span class="rig-dim__empty">—</span>
              </div>
            </div>
          </fieldset>

          <fieldset class="rig-section" data-ui-block="masts">
            <legend class="rig-section__title">3 · Masts &amp; sails</legend>

            <p class="rig-subtitle">Masts</p>
            <table class="rig-matrix">
              <thead>
                <tr>
                  <th scope="col">Mast</th>
                  <th scope="col">Present</th>
                  <th scope="col" data-mast-tier="topmast">Topmast</th>
                  <th scope="col" data-mast-tier="topgallant">Topgallant</th>
                </tr>
              </thead>
              <tbody>
                {MAST_IDS.map((mastId) => (
                  <tr>
                    <th scope="row">{MAST_LABELS[mastId].en}</th>
                    <td>
                      <input
                        class="rig-checkbox"
                        type="checkbox"
                        id={`mast-${mastId}-present`}
                        name={`mast-${mastId}-present`}
                        checked={defaults.masts[mastId].present}
                        aria-label={`${MAST_LABELS[mastId].en} present`}
                      />
                    </td>
                    <td data-mast-tier="topmast">
                      <input
                        class="rig-checkbox"
                        type="checkbox"
                        id={`mast-${mastId}-topmast`}
                        name={`mast-${mastId}-topmast`}
                        checked={defaults.masts[mastId].topmast}
                        aria-label={`${MAST_LABELS[mastId].en} topmast`}
                      />
                    </td>
                    <td data-mast-tier="topgallant">
                      <input
                        class="rig-checkbox"
                        type="checkbox"
                        id={`mast-${mastId}-topgallant`}
                        name={`mast-${mastId}-topgallant`}
                        checked={defaults.masts[mastId].topgallant}
                        aria-label={`${MAST_LABELS[mastId].en} topgallant`}
                      />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </fieldset>

          <div class="rig-section-group" data-ui-block="square">
            <p class="rig-subtitle">Square yards &amp; sails</p>
            <table class="rig-matrix">
              <thead>
                <tr>
                  <th scope="col">Mast</th>
                  <th scope="col">Tier</th>
                  <th scope="col">Yard</th>
                  <th scope="col">Sail</th>
                </tr>
              </thead>
              <tbody>
                {MAST_IDS.map((mastId) =>
                  TIERS.map((tier) => (
                    <tr data-tier-row={tier}>
                      <th scope="row">{MAST_LABELS[mastId].en}</th>
                      <td>{TIER_LABELS[tier].en}</td>
                      <td>
                        <input
                          class="rig-checkbox"
                          type="checkbox"
                          id={`mast-${mastId}-yard-${tier}`}
                          name={`mast-${mastId}-yard-${tier}`}
                          checked={defaults.masts[mastId].yards[tier]}
                          aria-label={`${MAST_LABELS[mastId].en} ${TIER_LABELS[tier].en} yard`}
                        />
                      </td>
                      <td>
                        <input
                          class="rig-checkbox"
                          type="checkbox"
                          id={`mast-${mastId}-sail-${tier}`}
                          name={`mast-${mastId}-sail-${tier}`}
                          checked={defaults.masts[mastId].sails[tier]}
                          aria-label={`${MAST_LABELS[mastId].en} ${TIER_LABELS[tier].en} sail`}
                        />
                      </td>
                    </tr>
                  )),
                )}
              </tbody>
            </table>
          </div>

          <div class="rig-section-group" data-ui-block="foreaft">
            <p class="rig-subtitle">Fore-and-aft sails</p>
            <table class="rig-matrix">
              <thead>
                <tr>
                  <th scope="col">Sail</th>
                  <th scope="col">Present</th>
                  <th scope="col">Supporting mast</th>
                </tr>
              </thead>
              <tbody>
                {SAIL_CLASSES.map((sailClass) => (
                  <tr data-sail-class={sailClass}>
                    <th scope="row">{SAIL_CLASS_LABELS[sailClass].en}</th>
                    <td>
                      <input
                        class="rig-checkbox"
                        type="checkbox"
                        id={`foreaft-${sailClass}-present`}
                        name={`foreaft-${sailClass}-present`}
                        checked={defaults.foreAndAft[sailClass].present}
                        aria-label={`${SAIL_CLASS_LABELS[sailClass].en} present`}
                      />
                    </td>
                    <td>
                      <select class="rig-select" id={`foreaft-${sailClass}-mast`} name={`foreaft-${sailClass}-mast`}>
                        {mastOptions.map((option) => (
                          <option value={option.value} selected={defaults.foreAndAft[sailClass].supportingMastId === option.value}>
                            {option.label}
                          </option>
                        ))}
                      </select>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="rig-section-group" data-ui-block="gaff">
            <p class="rig-subtitle">Gaff</p>
            <div class="rig-inline">
              <label class="rig-check">
                <input class="rig-checkbox" type="checkbox" id="gaff-present" name="gaff-present" checked={defaults.gaff.present} />
                <span>Gaff present</span>
              </label>
              <label class="rig-check">
                <input class="rig-checkbox" type="checkbox" id="gaff-sail" name="gaff-sail" checked={defaults.gaff.sailPresent} />
                <span>Sail bent</span>
              </label>
              <label class="rig-check rig-check--select">
                <span>Supporting mast</span>
                <select class="rig-select" id="gaff-mast" name="gaff-mast">
                  {mastOptions.map((option) => (
                    <option value={option.value} selected={defaults.gaff.supportingMastId === option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
              </label>
            </div>
          </div>

          <div class="rig-section-group" data-ui-block="lateen">
            <p class="rig-subtitle">Lateen mizzen</p>
            <div class="rig-inline">
              <label class="rig-check">
                <input class="rig-checkbox" type="checkbox" id="lateen-present" name="lateen-present" checked={defaults.lateenYard.present} />
                <span>Lateen yard</span>
              </label>
              <label class="rig-check">
                <input class="rig-checkbox" type="checkbox" id="lateen-sail" name="lateen-sail" checked={defaults.lateenYard.sailPresent} />
                <span>Sail set</span>
              </label>
              <label class="rig-check rig-check--select">
                <span>Supporting mast</span>
                <select class="rig-select" id="lateen-mast" name="lateen-mast">
                  {mastOptions.map((option) => (
                    <option value={option.value} selected={defaults.lateenYard.supportingMastId === option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
              </label>
            </div>
          </div>

          <div class="rig-section-group" data-ui-block="sailnodes">
            <p class="rig-subtitle">Yacht &amp; gaff sails</p>
            <table class="rig-matrix">
              <thead>
                <tr>
                  <th scope="col">Sail / spar</th>
                  {MAST_IDS.map((mastId) => (
                    <th scope="col">{MAST_LABELS[mastId].en}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {SAIL_NODE_KINDS.map((kind) => (
                  <tr data-sailnode-row={kind}>
                    <th scope="row">{SAIL_NODE_LABELS[kind]}</th>
                    {MAST_IDS.map((mastId) => (
                      <td>
                        <input
                          class="rig-checkbox"
                          type="checkbox"
                          id={`sailnode-${kind}-${mastId}`}
                          name={`sailnode-${kind}-${mastId}`}
                          checked={defaults.sailNodes[kind][mastId]}
                          aria-label={`${SAIL_NODE_LABELS[kind]} on ${MAST_LABELS[mastId].en}`}
                        />
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <fieldset class="rig-section" data-spars-fieldset>
            <legend class="rig-section__title">4 · Spars &amp; auxiliary gear</legend>

            <div class="rig-block" data-ui-block="bowsprit">
              <p class="rig-subtitle">Bowsprit &amp; spars</p>
              <div class="rig-inline">
                <label class="rig-check">
                  <input class="rig-checkbox" type="checkbox" id="bowsprit-present" name="bowsprit-present" checked={defaults.bowsprit.present} />
                  <span>Bowsprit</span>
                </label>
                <label class="rig-check" data-ui-flag="jibboom">
                  <input class="rig-checkbox" type="checkbox" id="jibboom-present" name="jibboom-present" checked={defaults.bowsprit.jibboom} />
                  <span>Jibboom</span>
                </label>
                <label class="rig-check" data-ui-flag="jibboom">
                  <input class="rig-checkbox" type="checkbox" id="flying-jibboom-present" name="flying-jibboom-present" checked={defaults.bowsprit.flyingJibboom} />
                  <span>Flying jibboom</span>
                </label>
                <label class="rig-check" data-ui-flag="martingale">
                  <input class="rig-checkbox" type="checkbox" id="martingale-present" name="martingale-present" checked={defaults.bowsprit.martingale} />
                  <span>Martingale</span>
                </label>
                <label class="rig-check" data-ui-flag="spritsaill">
                  <input class="rig-checkbox" type="checkbox" id="spritsail-yard-present" name="spritsail-yard-present" checked={defaults.bowsprit.spritsailYard} />
                  <span>Spritsail yard</span>
                </label>
                <label class="rig-check" data-ui-flag="spritsaill">
                  <input class="rig-checkbox" type="checkbox" id="spritsail-sail" name="spritsail-sail" checked={defaults.bowsprit.spritsailSail} />
                  <span>Spritsail sail</span>
                </label>
              </div>
            </div>

            <div class="rig-block" data-ui-block="hull">
              <p class="rig-subtitle">Hull &amp; general</p>
              <div class="rig-inline">
                <label class="rig-check">
                  <input class="rig-checkbox" type="checkbox" id="hull-group-present" name="hull-group-present" checked={defaults.hullGroup} />
                  <span>Hull &amp; general rigging (boltrope, sail-to-yard lashing)</span>
                </label>
              </div>
            </div>

            <div class="rig-block" data-ui-block="anchor">
              <p class="rig-subtitle">Anchor gear</p>
              <div class="rig-inline">
                <label class="rig-check">
                  <input class="rig-checkbox" type="checkbox" id="anchor-present" name="anchor-present" checked={defaults.anchor.present} />
                  <span>Anchor gear</span>
                </label>
                <label class="rig-check rig-check--select">
                  <span>Cable material</span>
                  <select class="rig-select" id="anchor-connection" name="anchor-connection">
                    <option value="fiber" selected={defaults.anchor.connection === 'fiber'}>Fibre cable</option>
                    <option value="chain" selected={defaults.anchor.connection === 'chain'}>Chain cable</option>
                  </select>
                </label>
              </div>
            </div>

            <div class="rig-block" data-ui-block="gun">
              <p class="rig-subtitle">Gun gear</p>
              <div class="rig-inline">
                <label class="rig-check">
                  <input class="rig-checkbox" type="checkbox" id="gun-present" name="gun-present" checked={defaults.gun.present} />
                  <span>Gun gear</span>
                </label>
                <label class="rig-check rig-check--select">
                  <span>Gun type</span>
                  <select class="rig-select" id="gun-type" name="gun-type">
                    <option value="carriage_gun" selected={defaults.gun.gunType === 'carriage_gun'}>Carriage gun</option>
                    <option value="carronade" selected={defaults.gun.gunType === 'carronade'}>Carronade</option>
                  </select>
                </label>
                <label class="rig-check rig-check--select">
                  <span>Mounting</span>
                  <select class="rig-select" id="gun-mounting" name="gun-mounting">
                    <option value="wheeled" selected={defaults.gun.mountingType === 'wheeled'}>Wheeled carriage</option>
                    <option value="slide_pivot" selected={defaults.gun.mountingType === 'slide_pivot'}>Slide / pivot mount</option>
                  </select>
                </label>
              </div>
            </div>
          </fieldset>

          <div class="rig-actions">
            <button class="rig-button" type="submit" id="calculate">Calculate diameters</button>
            <button class="rig-button rig-button--ghost" type="reset" id="reset">Reset to example</button>
            <button class="rig-button rig-button--ghost" type="button" id="load-preset">Load preset</button>
            <input class="rig-file-input" type="file" id="preset-file" accept="application/json,.json" hidden />
          </div>
