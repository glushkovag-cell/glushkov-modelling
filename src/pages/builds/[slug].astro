---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getAllModels,
  getBuildPartsByModel,
  getModelBySlug,
} from '../../lib/wordpress';

export async function getStaticPaths() {
  const models = await getAllModels();
  return models.map((model: any) => ({
    params: { slug: model.slug },
  }));
}

const { slug } = Astro.params;

const [model, parts] = await Promise.all([
  getModelBySlug(slug!),
  getBuildPartsByModel(slug!),
]);

if (!model) {
  return Astro.redirect('/builds');
}

const info = model.modelinfo;
---
<BaseLayout title={`${model.title} | Glushkov Modelling`}>

  <!-- 1. HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-card hero-copy">
        <a href="/builds" class="back-link">&#8592; Back to builds</a>
        <span class="eyebrow">Build Log</span>
        <h1>{model.title}</h1>

        <div class="hero-meta">
          {info?.buildstatus && (
            <span class="meta-pill">
              {Array.isArray(info.buildstatus)
                ? info.buildstatus.join(', ')
                : info.buildstatus}
            </span>
          )}
          {info?.modelscale && (
            <span class="meta-pill">Scale: {info.modelscale}</span>
          )}
          {info?.manufacturer && (
            <span class="meta-pill">{info.manufacturer}</span>
          )}
        </div>

        {parts.length > 1 && (
          <nav class="part-stepper" aria-label="Build log parts">
            {parts.map((part: any) => (
              <a
                href={`#part-${part.buildlog?.partnumber}`}
                class="part-step"
              >
                Part {part.buildlog?.partnumber}
              </a>
            ))}
          </nav>
        )}
      </div>

      <div class="hero-card hero-image">
        {info?.modelimageurl ? (
          <img
            src={info.modelimageurl}
            alt={model.title}
            class="glightbox"
          />
        ) : (
          <div class="no-image">No image yet</div>
        )}
      </div>
    </div>
  </section>

  <!-- 2. SHORT DESCRIPTION -->
  {info?.shortdescription && (
    <section class="page-section">
      <div class="container">
        <span class="eyebrow">About the Model</span>
        <p>{info.shortdescription}</p>
      </div>
    </section>
  )}

  <!-- 3. HISTORICAL NOTE -->
  {info?.historicalnote && (
    <section class="page-section">
      <div class="container">
        <span class="eyebrow">Historical Background</span>
        <h2>History</h2>
      </div>
    </section>
  )}

  <!-- 4. BUILD LOG PARTS -->
  {parts.length > 0 && (
    <section class="page-section">
      <div class="container">
        <span class="eyebrow">Build Log</span>
        <h2 class="section-title">All parts</h2>

        {parts.map((part: any) => (
          <article
            id={`part-${part.buildlog?.partnumber}`}
            class="build-part"
          >
            <div class="build-part-header">
              <span class="part-number">Part {part.buildlog?.partnumber}</span>
              <h3>{part.title}</h3>
            </div>

            {part.featuredImage?.node?.sourceUrl && (
              <div class="build-part-image">
                <img
                  src={part.featuredImage.node.sourceUrl}
                  alt={part.featuredImage.node.altText || part.title}
                  class="glightbox"
                  loading="lazy"
                />
              </div>
            )}

            {part.content && (
              <div class="build-part-content content-html" set:html={part.content} />
            )}
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- 5. PROJECT SPECS -->
  {info && (
    <section class="page-section">
      <div class="container">
        <span class="eyebrow">Project Specs</span>
        <h2 class="section-title">Model Info</h2>
        <div class="spec-grid">
          <div class="spec-item"><span class="spec-label">Model</span><span class="spec-value">{model.title || '&#8212;'}</span></div>
          <div class="spec-item"><span class="spec-label">Scale</span><span class="spec-value">{info.modelscale || '&#8212;'}</span></div>
          <div class="spec-item"><span class="spec-label">Manufacturer</span><span class="spec-value">{info.manufacturer || '&#8212;'}</span></div>
          <div class="spec-item"><span class="spec-label">Length</span><span class="spec-value">{info.modellength ? `${info.modellength} mm` : '&#8212;'}</span></div>
          <div class="spec-item"><span class="spec-label">Historical Year</span><span class="spec-value">{info.historicalyear || '&#8212;'}</span></div>
          <div class="spec-item"><span class="spec-label">Total Parts</span><span class="spec-value">{info.totalparts || '&#8212;'}</span></div>
          <div class="spec-item"><span class="spec-label">Status</span><span class="spec-value">{Array.isArray(info.buildstatus) ? info.buildstatus.join(', ') : info.buildstatus || '&#8212;'}</span></div>
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 12px;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .back-link:hover { color: var(--color-primary); }

  .part-stepper {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .part-step {
    font-size: 0.78rem;
    padding: 3px 10px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    text-decoration: none;
    opacity: 0.7;
    transition: color 0.15s, border-color 0.15s, opacity 0.15s;
  }
  .part-step:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    opacity: 1;
  }

  .build-part {
    border-top: 1px solid var(--color-border);
    padding-top: 32px;
    margin-top: 32px;
  }
  .build-part:first-child {
    border-top: none;
    margin-top: 0;
    padding-top: 0;
  }
  .build-part-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 20px;
  }
  .part-number {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .build-part-header h3 {
    margin: 0;
    font-size: 1.25rem;
  }
  .build-part-image {
    margin-bottom: 24px;
    border-radius: 8px;
    overflow: hidden;
  }
  .build-part-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .no-image {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 200px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    border-radius: 8px;
    font-size: 0.9rem;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.glightbox-gallery img').forEach((img) => {
      if (!img.parentElement?.classList.contains('glightbox')) {
        const a = document.createElement('a');
        a.href = (img as HTMLImageElement).src;
        a.classList.add('glightbox');
        img.parentNode?.insertBefore(a, img);
        a.appendChild(img);
      }
    });
    // @ts-ignore
    GLightbox({ selector: '.glightbox' });
  });
</script>
