---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getAllModels,
  getBuildPartsByModel,
  getModelBySlug,
  getAllNews,
  hasFreshNews,
} from '../../lib/wordpress';
import { getGalleryManifest } from '../../lib/gallery';
import SeoHead from '../../components/seo/SeoHead.astro';
import HiResViewer from '../../components/HiResViewer.astro';
import ContentMediaViewerBridge from '../../components/ContentMediaViewerBridge.astro';

const allNews = await getAllNews();
const newsFlag = hasFreshNews(allNews);

export async function getStaticPaths() {
  const models = await getAllModels();

  return models.map((model: any) => ({
    params: { slug: model.slug },
  }));
}

const { slug } = Astro.params;
const defaultBackLabel = 'Back to builds';
const defaultBackHref = '/builds';

const [model, parts, galleryManifest] = await Promise.all([
  getModelBySlug(slug!),
  getBuildPartsByModel(slug!),
  getGalleryManifest(slug!),
]);

if (!model) {
  return Astro.redirect('/builds');
}

const info = model.modelinfo;
const heroImage = info?.modelimageurl || null;
const heroImageAlt = model.title;
const hasGallery = !!galleryManifest;

const seoTitle = `${model.title} — Build Log | Glushkov Modelling`;
const seoDescription =
    info?.shortdescription ||
    `Step-by-step build log for ${model.title}${
        info?.modelscale ? `, scale ${info.modelscale}` : ''
    }${info?.manufacturer ? `, ${info.manufacturer}` : ''}. Wooden ship model construction by Andrey Glushkov.`;
const seoImage = heroImage || 'https://www.glushkov-modelling.com/og-default.jpg';
const seoDatePublished = info?.donedate ?? undefined;
---

<BaseLayout
    title={seoTitle}
    description={seoDescription}
    hasFreshNews={newsFlag}
    ogImage={seoImage}
>
  <SeoHead
      slot="head"
      pageType="build"
      title={seoTitle}
      description={seoDescription}
      ogImage={seoImage}
      buildTitle={model.title}
      buildDescription={info?.shortdescription}
      buildScale={info?.modelscale}
      buildManufacturer={info?.manufacturer}
      buildStatus={info?.buildstatus}
      buildHistoricalYear={info?.historicalyear}
      datePublished={seoDatePublished}
      breadcrumbs={[
        { name: 'Builds', url: '/builds' },
        { name: model.title, url: `/builds/${slug}` },
      ]}
  />

  <div id="top"></div>

  <section class="build-hero">
    <div class="container">
      <a
          href={defaultBackHref}
          class="detail-back-btn"
          id="detail-back-btn"
          data-default-href={defaultBackHref}
          data-default-label={defaultBackLabel}
      >
        <span class="detail-back-icon">←</span>
        <span id="detail-back-btn-label">{defaultBackLabel}</span>
      </a>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Build Log</p>
          <h1 class="section-title">{model.title}</h1>

          <div class="hero-meta">
            {info?.buildstatus && (
                <span class={`meta-pill status-pill ${model.buildstatusClass || ''}`}>
                {Array.isArray(info.buildstatus)
                    ? info.buildstatus.join(', ')
                    : info.buildstatus}
              </span>
            )}

            {info?.modelscale && (
                <span class="meta-pill">Scale: {info.modelscale}</span>
            )}

            {info?.manufacturer && (
                <span class="meta-pill">{info.manufacturer}</span>
            )}

            {hasGallery && (
                <a href={`/gallery/${model.slug}`} class="meta-pill gallery-cta-pill">
                  View gallery →
                </a>
            )}
          </div>

          {info?.shortdescription && (
              <p class="hero-summary">{info.shortdescription}</p>
          )}
        </div>

        {heroImage && (
            <div class="hero-image-wrap card">
              <img class="hero-image" src={heroImage} alt={heroImageAlt} />
            </div>
        )}
      </div>
    </div>
  </section>

  {parts.length > 1 && (
      <section class="parts-strip-section">
        <div class="container">
          <div class="section-head">
            <h2>Build Parts</h2>
            <a href="#build-log" class="section-link">Jump to full log</a>
          </div>

          <div class="parts-strip-wrap">
            <div class="parts-strip">
              {parts.map((part: any) => (
                  <a href={`#part-${part.partNumber}`} class="part-thumb-card">
                    {part.heroImage ? (
                        <img
                            src={part.heroImage}
                            alt={part.heroImageAlt || part.title}
                            loading="lazy"
                        />
                    ) : (
                        <div class="part-thumb-card__placeholder" aria-hidden="true"></div>
                    )}

                    <div class="part-thumb-card__body">
                  <span class="part-thumb-card__eyebrow">
                    Part {part.partNumber}
                  </span>
                      <h3>{part.title}</h3>
                    </div>
                  </a>
              ))}
            </div>
          </div>
        </div>
      </section>
  )}

  <section id="build-log" class="build-log-section">
    <div class="container">
      <div class="section-head">
        <h2>Build Log</h2>
      </div>

      <div class="build-log-list">
        {parts.map((part: any) => (
            <article id={`part-${part.partNumber}`} class="build-log-part card">
              <div class="build-log-part__header">
                <div>
                  <span class="build-log-part__eyebrow">Part {part.partNumber}</span>
                  <h3>{part.title}</h3>
                </div>

                <a href="#top">↑ Back to all parts</a>
              </div>

              {part.heroImage && (
                  <div class="build-log-part__hero">
                    <img
                        src={part.heroImage}
                        alt={part.heroImageAlt || part.title}
                        loading="lazy"
                    />
                  </div>
              )}

              {part.content && (
                  <div
                      class="build-log-part__content prose"
                      data-part-number={part.partNumber}
                      data-part-title={part.title}
                      set:html={part.content}
                  />
              )}
            </article>
        ))}
      </div>
    </div>
  </section>

  {hasGallery && (
      <section class="build-gallery-section">
        <div class="container">
          <div class="build-gallery-cta card">
            <div>
              <span class="eyebrow">Gallery</span>
              <h2>Explore the photo gallery</h2>
              <p>Open the dedicated gallery view for hi-res images of this build.</p>
            </div>

            <a href={`/gallery/${model.slug}`} class="btn-primary">
              Open gallery
            </a>
          </div>
        </div>
      </section>
  )}

  <HiResViewer />
  <ContentMediaViewerBridge
      rootSelector=".build-log-part__content"
      titleAttr="data-part-title"
      itemTitleBuilder="build-part"
  />
</BaseLayout>

<script>
  function initBuildBackLink() {
    const backLink = document.getElementById('detail-back-btn');

    if (!(backLink instanceof HTMLAnchorElement)) {
      return;
    }

    const params = new URLSearchParams(window.location.search);
    const returnTo = params.get('returnTo');

    backLink.href =
        returnTo && returnTo.startsWith('/builds')
            ? returnTo
            : '/builds';
  }

  initBuildBackLink();
  document.addEventListener('astro:page-load', initBuildBackLink);
</script>

<style is:global>
  .build-hero {
    padding: 3rem 0 2rem;
  }

  .detail-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1.2;
  }

  .detail-back-btn:hover {
    color: var(--color-primary);
  }

  .detail-back-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 520px);
    gap: 2rem;
    align-items: start;
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1rem 0 1.25rem;
  }

  .hero-summary {
    margin: 0;
    color: var(--color-text-muted);
    max-width: 62ch;
  }

  .hero-image-wrap {
    overflow: hidden;
  }

  .hero-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .parts-strip-section,
  .build-log-section,
  .build-gallery-section {
    padding: 2rem 0;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .section-head h2 {
    margin: 0;
  }

  .section-link {
    color: var(--color-primary);
    text-decoration: none;
  }

  .parts-strip-wrap {
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

  .parts-strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(220px, 260px);
    gap: 1rem;
  }

  .part-thumb-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: inherit;
    text-decoration: none;
  }

  .part-thumb-card img,
  .part-thumb-card__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--color-surface-offset);
  }

  .part-thumb-card__body {
    padding: 1rem;
  }

  .part-thumb-card__eyebrow,
  .build-log-part__eyebrow {
    display: inline-block;
    margin-bottom: 0.35rem;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .part-thumb-card__body h3,
  .build-log-part__header h3 {
    margin: 0;
  }

  .build-log-list {
    display: grid;
    gap: 1.5rem;
  }

  .build-log-part {
    padding: 1.5rem;
  }

  .build-log-part__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .build-log-part__header a {
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
  }

  .build-log-part__hero {
    margin-bottom: 1.25rem;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .build-log-part__hero img {
    display: block;
    width: 100%;
    height: auto;
  }

  .build-gallery-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem;
  }

  .build-gallery-cta h2 {
    margin: 0.35rem 0 0.5rem;
  }

  .build-gallery-cta p {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .build-gallery-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 767px) {
    .build-hero {
      padding: 2rem 0 1.5rem;
    }

    .section-head,
    .build-log-part__header {
      flex-direction: column;
      align-items: flex-start;
    }

    .parts-strip {
      grid-auto-columns: minmax(200px, 240px);
    }

    .build-log-part {
      padding: 1.25rem;
    }
  }
</style>
