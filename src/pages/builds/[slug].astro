---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllBuilds, getBuildBySlug } from '../../lib/wordpress';

export async function getStaticPaths() {
  const builds = await getAllBuilds();

  return builds.map((build) => ({
    params: { slug: build.slug },
  }));
}

const { slug } = Astro.params;
const post = await getBuildBySlug(slug!);

if (!post) {
  throw Astro.redirect('/builds');
}

const { title, content, featuredImage, buildLog } = post;
const status = Array.isArray(buildLog?.buildStatus)
  ? buildLog.buildStatus.join(', ')
  : buildLog?.buildStatus;
---

<BaseLayout title={`${title} | Glushkov Modelling`}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-card hero-copy">
        <a href="/builds" class="back-link">← Back to builds</a>
        <span class="eyebrow">Build Log</span>
        <h1>{title}</h1>
        <p>
          A documented model ship build with historical accuracy, material notes,
          construction decisions, and visual progress from workshop to finished display.
        </p>

        <div class="hero-meta">
          {buildLog?.modelScale && <span class="meta-pill">Scale: {buildLog.modelScale}</span>}
          {buildLog?.manufacturer && <span class="meta-pill">Kit: {buildLog.manufacturer}</span>}
          {status && <span class="meta-pill">Status: {status}</span>}
          {buildLog?.partNumber && <span class="meta-pill">Part: {buildLog.partNumber}</span>}
        </div>
      </div>

      <div class="hero-card hero-image">
        {featuredImage?.node?.sourceUrl ? (
          <img
            src={featuredImage.node.sourceUrl}
            alt={featuredImage.node.altText || title}
            loading="lazy"
          />
        ) : (
          <div class="gallery-placeholder">No featured image yet</div>
        )}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container section-grid">
      <article class="content-card">
        <span class="eyebrow">Project Notes</span>
        <h2 class="section-title">Build narrative</h2>
        <div class="content-html" set:html={content} />
      </article>

      <aside class="info-card">
        <span class="eyebrow">Project Specs</span>
        <h3 class="card-title">Build info</h3>

        <div class="spec-list">
          <div class="spec-item">
            <span class="spec-label">Model</span>
            <span class="spec-value">{title}</span>
          </div>

          <div class="spec-item">
            <span class="spec-label">Scale</span>
            <span class="spec-value">{buildLog?.modelScale || '—'}</span>
          </div>

          <div class="spec-item">
            <span class="spec-label">Manufacturer</span>
            <span class="spec-value">{buildLog?.manufacturer || '—'}</span>
          </div>

          <div class="spec-item">
            <span class="spec-label">Status</span>
            <span class="spec-value">{status || '—'}</span>
          </div>

          <div class="spec-item">
            <span class="spec-label">Part Number</span>
            <span class="spec-value">{buildLog?.partNumber || '—'}</span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="gallery-card">
        <span class="eyebrow">Gallery</span>
        <h2 class="section-title">Detailed views</h2>
        <div class="gallery-placeholder">
          Gallery block will go here next: lightbox, process photos, and detail shots.
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
