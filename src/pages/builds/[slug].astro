---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoHead from '../../components/seo/SeoHead.astro';
import {
  getAllModels,
  getBuildPartsByModel,
  getModelBySlug,
  getAllNews,
  hasFreshNews,
} from '../../lib/wordpress';
import { getGalleryManifest } from '../../lib/gallery';

const allNews = await getAllNews();
const newsFlag = hasFreshNews(allNews);

export async function getStaticPaths() {
  const models = await getAllModels();
  return models.map((model: any) => ({
    params: { slug: model.slug },
  }));
}

const { slug } = Astro.params;
const defaultBackLabel = 'Back to builds';
const defaultBackHref = '/builds';

const [model, parts, galleryManifest] = await Promise.all([
  getModelBySlug(slug!),
  getBuildPartsByModel(slug!),
  getGalleryManifest(slug!),
]);

if (!model) {
  return Astro.redirect('/builds');
}

const info = model.modelinfo;
const heroImage = info?.modelimageurl || null;
const heroImageAlt = model.title;
const hasGallery = !!galleryManifest;

// SEO
const seoTitle = `${model.title} — Build Log | Glushkov Modelling`;
const seoDescription = info?.shortdescription
  || `Step-by-step build log for ${model.title}${info?.modelscale ? `, scale ${info.modelscale}` : ''}${info?.manufacturer ? `, ${info.manufacturer}` : ''}. Wooden ship model construction by Andrey Glushkov.`;
const seoImage = info?.modelimageurl ?? 'https://www.glushkov-modelling.com/og-default.jpg';
const seoDatePublished = info?.donedate ?? undefined;
---

<BaseLayout
    title={seoTitle}
    description={seoDescription}
    hasFreshNews={newsFlag}
    ogImage={seoImage}
>
  <SeoHead
    slot="head"
    pageType="build"
    title={seoTitle}
    description={seoDescription}
    ogImage={seoImage}
    buildTitle={model.title}
    buildDescription={info?.shortdescription}
    buildScale={info?.modelscale}
    buildManufacturer={info?.manufacturer}
    buildStatus={info?.buildstatus}
    buildHistoricalYear={info?.historicalyear}
    datePublished={seoDatePublished}
    breadcrumbs={[
      { name: 'Builds', url: '/builds' },
      { name: model.title, url: `/builds/${slug}` },
    ]}
  />

  <div id="top"></div>

  <section class="build-hero">
    <div class="container">

      <a
          href={defaultBackHref}
          class="detail-back-btn"
          id="detail-back-btn"
          data-default-href={defaultBackHref}
          data-default-label={defaultBackLabel}
          data-tutorial-label="Back to tutorial"
      >
        <span class="detail-back-icon">←</span>
        <span id="detail-back-btn-label">{defaultBackLabel}</span>
      </a>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Build Log</p>
          <h1 class="section-title">{model.title}</h1>

          <div class="hero-meta">
            {info?.buildstatus && (
                <span class={`meta-pill status-pill ${model.buildstatusClass || ''}`}>
                {Array.isArray(info.buildstatus)
                    ? info.buildstatus.join(', ')
                    : info.buildstatus}
              </span>
            )}
            {info?.modelscale && (<span class="meta-pill">Scale: {info.modelscale}</span>)}
            {info?.manufacturer && (<span class="meta-pill">{info.manufacturer}</span>)}
            {hasGallery && (
                <a href={`/gallery/${model.slug}`} class="meta-pill gallery-cta-pill">
                  View gallery →
                </a>
            )}
          </div>

          {info?.shortdescription && (
              <p class="hero-summary">{info.shortdescription}</p>
          )}
        </div>

        {heroImage && (
            <div class="hero-image-wrap card">
              <img class="hero-image" src={heroImage} alt={heroImageAlt} />
            </div>
        )}
      </div>
    </div>
  </section>

  {parts.length > 1 && (
      <section class="parts-strip-section">
        <div class="container">
          <div class="section-head">
            <h2>Build Parts</h2>
            <a href="#build-log" class="section-link">Jump to full log</a>
          </div>
          <div class="parts-strip-wrap">
            <div class="parts-strip">
              {parts.map((part: any) => (
                  <a href={`#part-${part.partNumber}`} class="part-thumb-card">
                    {part.heroImage ? (
                        <img src={part.heroImage} alt={part.heroImageAlt} class="part-thumb-image" loading="lazy" />
                    ) : (
                        <div class="part-thumb-placeholder">Part {part.partNumber}</div>
                    )}
                    <div class="part-thumb-body">
                      <span class="part-thumb-number">Part {part.partNumber}</span>
                      <span class="part-thumb-title">{part.title}</span>
                    </div>
                  </a>
              ))}
            </div>
          </div>
        </div>
      </section>
  )}

  {info?.historicalnote && (
      <section class="section">
        <div class="container narrow">
          <article class="prose-card card">
            <h2>Historical Background</h2>
            <div set:html={info.historicalnote} />
          </article>
        </div>
      </section>
  )}

  <span id="build-log" aria-hidden="true"></span>

  {parts.length > 0 && (
      <section class="section">
        <div class="container narrow">
          <h2>Build Log</h2>
          {parts.map((part: any) => (
              <article id={`part-${part.partNumber}`} class="build-part-card card">
                <header class="part-header">
                  <div class="part-header-top">
                    <p class="eyebrow">Part {part.partNumber}</p>
                    {part.recordDay && (<span class="part-date">{part.recordDay}</span>)}
                  </div>
                  <h3>{part.title}</h3>
                </header>
                {part.partContent ? (
                    <div class="part-content" set:html={part.partContent} />
                ) : (
                    <p>Content coming soon.</p>
                )}
                {parts.length > 1 && (
                    <p class="back-top"><a href="#top">↑ Back to all parts</a></p>
                )}
              </article>
          ))}
        </div>
      </section>
  )}

  {info && (
      <section class="section specs-shell">
        <div class="container narrow">
          <article class="specs-card card">
            <div class="section-head specs-head">
              <h2>Project Specs</h2>
            </div>
            <dl class="specs-grid">
              <div class="spec-item"><dt>Model</dt><dd>{model.title || '—'}</dd></div>
              <div class="spec-item"><dt>Scale</dt><dd>{info.modelscale || '—'}</dd></div>
              <div class="spec-item"><dt>Manufacturer</dt><dd>{info.manufacturer || '—'}</dd></div>
              <div class="spec-item"><dt>Length</dt><dd>{info.modellength ? `${info.modellength} mm` : '—'}</dd></div>
              <div class="spec-item"><dt>Historical Year</dt><dd>{info.historicalyear || '—'}</dd></div>
              <div class="spec-item"><dt>Total Parts</dt><dd>{info.totalparts || '—'}</dd></div>
              <div class="spec-item">
                <dt>Status</dt>
                <dd>{Array.isArray(info.buildstatus) ? info.buildstatus.join(', ') : info.buildstatus || '—'}</dd>
              </div>
            </dl>
          </article>
        </div>
      </section>
  )}
</BaseLayout>
