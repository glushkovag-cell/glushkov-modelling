---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getAllModels,
  getBuildPartsByModel,
  getModelBySlug,
} from '../../lib/wordpress';

export async function getStaticPaths() {
  const models = await getAllModels();
  return models.map((model: any) => ({
    params: { slug: model.slug },
  }));
}

const { slug } = Astro.params;

const [model, parts] = await Promise.all([
  getModelBySlug(slug!),
  getBuildPartsByModel(slug!),
]);

if (!model) {
  return Astro.redirect('/builds');
}

const info = model.modelinfo;
---

<BaseLayout title={`${model.title} | Glushkov Modelling`}>

  <!-- 1. HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-card hero-copy">
        <a href="/builds" class="back-link">&larr; Back to builds</a>
        <span class="eyebrow">Build Log</span>
        <h1>{model.title}</h1>

        <div class="hero-meta">
          {info?.buildstatus && (
            <span class="meta-pill">
              {Array.isArray(info.buildstatus)
                ? info.buildstatus.join(', ')
                : info.buildstatus}
            </span>
          )}
          {info?.modelscale && (
            <span class="meta-pill">Scale: {info.modelscale}</span>
          )}
          {info?.manufacturer && (
            <span class="meta-pill">{info.manufacturer}</span>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PART STEPPER -->
  {parts.length > 1 && (
    <div class="container">
      <nav class="part-stepper">
        {parts.map((part: any) => (
          <a
            href={`#part-${part.buildlog?.partnumber}`}
            class="part-step"
          >
            {part.featuredImage?.node?.sourceUrl && (
              <img
                src={part.featuredImage.node.sourceUrl}
                alt={part.featuredImage.node.altText || `Part ${part.buildlog?.partnumber}`}
                class="part-step-thumb"
                loading="lazy"
              />
            )}
            <span>Part {part.buildlog?.partnumber}</span>
          </a>
        ))}
      </nav>
    </div>
  )}

  <!-- 3. HERO IMAGE -->
  <div class="container">
    {info?.modelimageurl ? (
      <img src={info.modelimageurl} alt={model.title} class="model-hero-image" />
    ) : (
      <div class="no-image">No image yet</div>
    )}
  </div>

  <!-- 4. ABOUT -->
  {info?.shortdescription && (
    <section class="page-section">
      <div class="container">
        <span class="eyebrow">About the Model</span>
        <p>{info.shortdescription}</p>
      </div>
    </section>
  )}

  {info?.historicalnote && (
    <section class="page-section">
      <div class="container">
        <span class="eyebrow">Historical Background</span>
        <h2>History</h2>
      </div>
    </section>
  )}

  <!-- 5. BUILD LOG PARTS -->
  {parts.length > 0 && (
    <section class="page-section">
      <div class="container">
        <span class="eyebrow">Build Log</span>
        <h2>All parts</h2>

        {parts.map((part: any) => (
          <div class="build-part" id={`part-${part.buildlog?.partnumber}`}>
            <div class="build-part-header">
              <span class="part-number">Part {part.buildlog?.partnumber}</span>
              <h3>{part.title}</h3>
            </div>

            {part.featuredImage?.node?.sourceUrl && (
              <div class="build-part-image glightbox-gallery">
                <img
                  src={part.featuredImage.node.sourceUrl}
                  alt={part.featuredImage.node.altText}
                />
              </div>
            )}

            {part.content && (
              <div set:html={part.content} />
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- 6. SPECS -->
  {info && (
    <section class="page-section">
      <div class="container">
        <span class="eyebrow">Project Specs</span>
        <h2>Model Info</h2>
        <dl class="specs-list">
          <div><dt>Model</dt><dd>{model.title || '&#8212;'}</dd></div>
          <div><dt>Scale</dt><dd>{info.modelscale || '&#8212;'}</dd></div>
          <div><dt>Manufacturer</dt><dd>{info.manufacturer || '&#8212;'}</dd></div>
          <div><dt>Length</dt><dd>{info.modellength ? `${info.modellength} mm` : '&#8212;'}</dd></div>
          <div><dt>Historical Year</dt><dd>{info.historicalyear || '&#8212;'}</dd></div>
          <div><dt>Total Parts</dt><dd>{info.totalparts || '&#8212;'}</dd></div>
          <div><dt>Status</dt><dd>{Array.isArray(info.buildstatus) ? info.buildstatus.join(', ') : info.buildstatus || '&#8212;'}</dd></div>
        </dl>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 12px;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .back-link:hover { color: var(--color-primary); }

  .part-stepper {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
    margin-bottom: 24px;
  }
  .part-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 0.78rem;
    padding: 6px 10px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    color: var(--color-text-muted);
    text-decoration: none;
    opacity: 0.7;
    transition: color 0.15s, border-color 0.15s, opacity 0.15s;
  }
  .part-step:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    opacity: 1;
  }
  .part-step-thumb {
    width: 48px;
    height: 36px;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }

  .model-hero-image {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border-radius: 8px;
    margin: 24px 0;
  }

  .build-part {
    border-top: 1px solid var(--color-border);
    padding-top: 32px;
    margin-top: 32px;
  }
  .build-part:first-child {
    border-top: none;
    margin-top: 0;
    padding-top: 0;
  }
  .build-part-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 20px;
  }
  .part-number {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .build-part-header h3 {
    margin: 0;
    font-size: 1.25rem;
  }
  .build-part-image {
    margin-bottom: 24px;
    border-radius: 8px;
    overflow: hidden;
  }
  .build-part-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .no-image {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 200px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    border-radius: 8px;
    font-size: 0.9rem;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.glightbox-gallery img').forEach((img) => {
      if (!img.parentElement?.classList.contains('glightbox')) {
        const a = document.createElement('a');
        a.href = (img as HTMLImageElement).src;
        a.classList.add('glightbox');
        img.parentNode?.insertBefore(a, img);
        a.appendChild(img);
      }
    });
    // @ts-ignore
    GLightbox({ selector: '.glightbox' });
  });
</script>
