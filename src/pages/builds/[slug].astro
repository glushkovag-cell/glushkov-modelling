---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getAllModels,
  getBuildPartsByModel,
  getModelBySlug,
  getAllNews,
  hasFreshNews,
} from '../../lib/wordpress';
import { getGalleryManifest } from '../../lib/gallery';

const allNews = await getAllNews();
const newsFlag = hasFreshNews(allNews);

export async function getStaticPaths() {
  const models = await getAllModels();

  return models.map((model: any) => ({
    params: { slug: model.slug },
  }));
}

const { slug } = Astro.params;

const [model, parts, galleryManifest] = await Promise.all([
  getModelBySlug(slug!),
  getBuildPartsByModel(slug!),
  getGalleryManifest(slug!),
]);

if (!model) {
  return Astro.redirect('/builds');
}

const info = model.modelinfo;
const heroImage = info?.modelimageurl || null;
const heroImageAlt = model.title;
const hasGallery = !!galleryManifest;
---

<BaseLayout
    title={`${model.title} — Build Log`}
    description={info?.shortdescription || `Build log for ${model.title}`}
    hasFreshNews={newsFlag}
>
  <div id="top"></div>

  <section class="build-hero">
    <div class="container">
      <button
          type="button"
          class="detail-back-btn"
          id="backToBuildsBtn"
      >
        <span class="detail-back-icon">←</span>
        <span>Back to builds</span>
      </button>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Build Log</p>
          <h1 class="section-title">{model.title}</h1>

          <div class="hero-meta">
            {info?.buildstatus && (
                <span class={`meta-pill status-pill ${model.buildstatusClass || ''}`}>
                {Array.isArray(info.buildstatus)
                    ? info.buildstatus.join(', ')
                    : info.buildstatus}
              </span>
            )}

            {info?.modelscale && (
                <span class="meta-pill">Scale: {info.modelscale}</span>
            )}

            {info?.manufacturer && (
                <span class="meta-pill">{info.manufacturer}</span>
            )}

            {hasGallery && (
                <a href={`/gallery/${model.slug}`} class="meta-pill gallery-cta-pill">
                  View gallery →
                </a>
            )}
          </div>

          {info?.shortdescription && (
              <p class="hero-summary">{info.shortdescription}</p>
          )}
        </div>

        {heroImage && (
            <div class="hero-image-wrap card">
              <img class="hero-image" src={heroImage} alt={heroImageAlt} />
            </div>
        )}
      </div>
    </div>
  </section>

  {parts.length > 1 && (
      <section class="parts-strip-section">
        <div class="container">
          <div class="section-head">
            <h2>Build Parts</h2>
            <a href="#build-log" class="section-link">Jump to full log</a>
          </div>

          <div class="parts-strip-wrap">
            <div class="parts-strip">
              {parts.map((part: any) => (
                  <a href={`#part-${part.partNumber}`} class="part-thumb-card">
                    {part.heroImage ? (
                        <img
                            src={part.heroImage}
                            alt={part.heroImageAlt}
                            class="part-thumb-image"
                            loading="lazy"
                        />
                    ) : (
                        <div class="part-thumb-placeholder">Part {part.partNumber}</div>
                    )}

                    <div class="part-thumb-body">
                      <span class="part-thumb-number">Part {part.partNumber}</span>
                      <span class="part-thumb-title">{part.title}</span>
                    </div>
                  </a>
              ))}
            </div>
          </div>
        </div>
      </section>
  )}

  {info?.historicalnote && (
      <section class="section">
        <div class="container narrow">
          <article class="prose-card card">
            <h2>Historical Background</h2>
            <div set:html={info.historicalnote} />
          </article>
        </div>
      </section>
  )}

  <span id="build-log" aria-hidden="true"></span>

  {parts.length > 0 && (
      <section class="section">
        <div class="container narrow">
          <h2>Build Log</h2>

          {parts.map((part: any) => (
              <article id={`part-${part.partNumber}`} class="build-part-card card">
                <header class="part-header">
                  <div class="part-header-top">
                    <p class="eyebrow">Part {part.partNumber}</p>
                    {part.recordDay && (
                        <span class="part-date">{part.recordDay}</span>
                    )}
                  </div>
                  <h3>{part.title}</h3>
                </header>

                {part.partContent ? (
                    <div class="part-content" set:html={part.partContent} />
                ) : (
                    <p>Content coming soon.</p>
                )}

                {parts.length > 1 && (
                    <p class="back-top">
                      <a href="#top">↑ Back to all parts</a>
                    </p>
                )}
              </article>
          ))}
        </div>
      </section>
  )}

  {info && (
      <section class="section specs-shell">
        <div class="container narrow">
          <article class="specs-card card">
            <div class="section-head specs-head">
              <h2>Project Specs</h2>
            </div>

            <dl class="specs-grid">
              <div class="spec-item">
                <dt>Model</dt>
                <dd>{model.title || '—'}</dd>
              </div>

              <div class="spec-item">
                <dt>Scale</dt>
                <dd>{info.modelscale || '—'}</dd>
              </div>

              <div class="spec-item">
                <dt>Manufacturer</dt>
                <dd>{info.manufacturer || '—'}</dd>
              </div>

              <div class="spec-item">
                <dt>Length</dt>
                <dd>{info.modellength ? `${info.modellength} mm` : '—'}</dd>
              </div>

              <div class="spec-item">
                <dt>Historical Year</dt>
                <dd>{info.historicalyear || '—'}</dd>
              </div>

              <div class="spec-item">
                <dt>Total Parts</dt>
                <dd>{info.totalparts || '—'}</dd>
              </div>

              <div class="spec-item">
                <dt>Status</dt>
                <dd>
                  {Array.isArray(info.buildstatus)
                      ? info.buildstatus.join(', ')
                      : info.buildstatus || '—'}
                </dd>
              </div>
            </dl>
          </article>
        </div>
      </section>
  )}
</BaseLayout>

<style>
  .container {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .container.narrow {
    width: min(820px, calc(100% - 2rem));
  }

  .build-hero {
    padding: 2.5rem 0 2rem;
  }

  /* Новый стиль Back to builds — такой же, как на tutorial */
  .detail-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font-family: 'General Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.1s ease;
    margin-bottom: 1.5rem;
  }

  .detail-back-btn:hover {
    background: var(--color-surface-2); /* или var(--color-surface), если хочешь чуть менее заметный эффект */
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }

  .detail-back-icon {
    font-size: 0.9rem;
  }

  .gallery-cta-pill {
    border-color: var(--color-primary);
    background: var(--color-primary-highlight);
    color: var(--color-primary);
    text-decoration: none;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }

  .gallery-cta-pill:hover {
    background: var(--color-primary);
    color: var(--color-text-inverse);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: 2rem;
    align-items: start;
  }

  .hero-copy h1 {
    margin: 0;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .meta-pill {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1;
    white-space: nowrap;
  }

  .status-pill {
    background: color-mix(in srgb, var(--color-primary) 10%, var(--color-surface));
    color: var(--color-primary);
    border-color: color-mix(in srgb, var(--color-primary) 18%, var(--color-border));
    font-weight: 600;
  }

  .hero-summary {
    margin-top: 1.25rem;
    max-width: 62ch;
    color: var(--color-text-muted);
  }

  .hero-image-wrap {
    border-radius: 1rem;
  }

  .hero-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .section {
    padding: 2.5rem 0;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .section-link {
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .section-link:hover {
    text-decoration: underline;
  }

  .parts-strip-section {
    padding: 0.5rem 0 1rem;
  }

  .parts-strip-wrap {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.5rem;
  }

  .parts-strip {
    display: flex;
    flex-wrap: nowrap;
    gap: 1rem;
    width: max-content;
    min-width: 100%;
  }

  .parts-strip-wrap::-webkit-scrollbar {
    height: 10px;
  }

  .parts-strip-wrap::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 999px;
  }

  .part-thumb-card {
    flex: 0 0 210px;
    width: 210px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .part-thumb-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .part-thumb-image,
  .part-thumb-placeholder {
    display: block;
    width: 100%;
    height: 130px;
    flex: 0 0 130px;
  }

  .part-thumb-image {
    object-fit: cover;
  }

  .part-thumb-placeholder {
    background: var(--color-surface-offset);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
  }

  .part-thumb-body {
    display: grid;
    gap: 0.3rem;
    padding: 0.85rem 0.95rem 1rem;
  }

  .part-thumb-number {
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
    font-weight: 700;
  }

  .part-thumb-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.35;
    font-weight: 600;
  }

  .prose-card,
  .build-part-card,
  .specs-card {
    padding: 1.5rem;
  }

  .prose-card h2 {
    margin-bottom: 1.25rem;
  }

  .section > .container.narrow > h2 {
    margin-bottom: 1.5rem;
  }

  .build-part-card + .build-part-card {
    margin-top: 1.5rem;
  }

  .part-header-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0;
  }

  .part-header-top .eyebrow {
    margin: 0;
  }

  .part-date {
    font-size: 0.82rem;
    line-height: 1.2;
    color: var(--color-text-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .part-header h3 {
    margin-top: 0.15rem;
  }

  .part-content :global(p) {
    margin: 1rem 0;
  }

  .part-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.25rem 0;
    border-radius: 0.75rem;
  }

  .back-top {
    margin-top: 1.25rem;
  }

  .back-top a {
    text-decoration: none;
    color: var(--color-primary);
  }

  .back-top a:hover {
    text-decoration: underline;
  }

  .specs-shell {
    padding-top: 1rem;
    padding-bottom: 3rem;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .spec-item {
    padding: 1rem 1rem 0.95rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-surface-2);
  }

  .spec-item dt {
    margin-bottom: 0.4rem;
    font-size: 0.78rem;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-weight: 700;
  }

  .spec-item dd {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.45;
    color: var(--color-text);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-image-wrap {
      max-width: 760px;
    }
  }

  @media (max-width: 640px) {
    .build-hero {
      padding-top: 2rem;
    }

    .section {
      padding: 2rem 0;
    }

    .part-thumb-card {
      flex-basis: 185px;
      width: 185px;
    }

    .part-thumb-image,
    .part-thumb-placeholder {
      height: 116px;
      flex-basis: 116px;
    }

    .specs-grid {
      grid-template-columns: 1fr;
    }

    .section-head {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var btn = document.getElementById('backToBuildsBtn');
    if (!btn) return;

    btn.addEventListener('click', function () {
      var ref = document.referrer || '';
      var cameFromBuilds =
          ref.indexOf('/builds') !== -1 || ref.indexOf('/builds?') !== -1;

      if (cameFromBuilds && window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/builds';
      }
    });
  });
</script>