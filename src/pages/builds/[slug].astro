---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getAllModels,
  getBuildPartsByModel,
  getModelBySlug,
} from '../../lib/wordpress';

export async function getStaticPaths() {
  const models = await getAllModels();

  return models.map((model: any) => ({
    params: { slug: model.slug },
  }));
}

const { slug } = Astro.params;

const [model, parts] = await Promise.all([
  getModelBySlug(slug!),
  getBuildPartsByModel(slug!),
]);

if (!model) {
  return Astro.redirect('/builds');
}

const info = model.modelinfo;
const heroImage = model.featuredImage?.node?.sourceUrl;
const heroImageAlt = model.featuredImage?.node?.altText || model.title;
---

<BaseLayout title={`${model.title} | Glushkov Modelling`}>
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-copy">
          <a href="/builds" class="back-link">← Back to builds</a>
          <span class="eyebrow">Build Log</span>
          <h1>{model.title}</h1>

          <div class="hero-meta">
            {info?.buildstatus && (
              <span class="meta-pill">
                {Array.isArray(info.buildstatus)
                  ? info.buildstatus.join(', ')
                  : info.buildstatus}
              </span>
            )}

            {info?.modelscale && (
              <span class="meta-pill">Scale: {info.modelscale}</span>
            )}

            {info?.manufacturer && (
              <span class="meta-pill">{info.manufacturer}</span>
            )}
          </div>
        </div>

        {heroImage && (
          <div class="hero-image">
            <img
              src={heroImage}
              alt={heroImageAlt}
              loading="lazy"
            />
          </div>
        )}
      </div>
    </div>
  </section>

  {parts.length > 1 && (
    <div class="container">
      <nav class="part-stepper" id="parts-nav">
        {parts.map((part: any) => (
          <a
            href={`#part-${part.buildlog?.partnumber}`}
            class="part-step"
          >
            {part.featuredImage?.node?.sourceUrl && (
              <img
                src={part.featuredImage.node.sourceUrl}
                alt={
                  part.featuredImage.node.altText ||
                  `Part ${part.buildlog?.partnumber}`
                }
                class="part-step-thumb"
                loading="lazy"
              />
            )}
            <span>Part {part.buildlog?.partnumber}</span>
          </a>
        ))}
      </nav>
    </div>
  )}

  {info?.shortdescription && (
    <section class="page-section">
      <div class="container">
        <span class="eyebrow">About the Model</span>
        <p>{info.shortdescription}</p>
      </div>
    </section>
  )}

  {info?.historicalnote && (
    <section class="page-section">
      <div class="container">
        <span class="eyebrow">Historical Background</span>
        <div class="historical-note" set:html={info.historicalnote} />
      </div>
    </section>
  )}

  {parts.length > 0 && (
    <section class="page-section">
      <div class="container">
        <span class="eyebrow">Build Log</span>
        <h2>All parts</h2>

        {parts.map((part: any) => (
          <div class="build-part" id={`part-${part.buildlog?.partnumber}`}>
            <div class="build-part-header">
              <span class="part-number">Part {part.buildlog?.partnumber}</span>
              <h3>{part.title}</h3>
            </div>

            {part.buildlog?.partcontent ? (
              <div class="part-content" set:html={part.buildlog.partcontent} />
            ) : part.content ? (
              <div class="part-content" set:html={part.content} />
            ) : (
              <p class="no-content">Content coming soon.</p>
            )}

            {parts.length > 1 && (
              <div class="part-back">
                <a href="#parts-nav" class="part-back-link">
                  ↑ Back to all parts
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  {info && (
    <section class="page-section">
      <div class="container">
        <span class="eyebrow">Project Specs</span>

        <dl class="specs-grid">
          <div class="spec-card">
            <dt>Model</dt>
            <dd>{model.title || '—'}</dd>
          </div>

          <div class="spec-card">
            <dt>Scale</dt>
            <dd>{info.modelscale || '—'}</dd>
          </div>

          <div class="spec-card">
            <dt>Manufacturer</dt>
            <dd>{info.manufacturer || '—'}</dd>
          </div>

          <div class="spec-card">
            <dt>Length</dt>
            <dd>{info.modellength ? `${info.modellength} mm` : '—'}</dd>
          </div>

          <div class="spec-card">
            <dt>Historical Year</dt>
            <dd>{info.historicalyear || '—'}</dd>
          </div>

          <div class="spec-card">
            <dt>Total Parts</dt>
            <dd>{info.totalparts || '—'}</dd>
          </div>

          <div class="spec-card">
            <dt>Status</dt>
            <dd>
              {Array.isArray(info.buildstatus)
                ? info.buildstatus.join(', ')
                : info.buildstatus || '—'}
            </dd>
          </div>
        </dl>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 12px;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 420px);
    gap: 32px;
    align-items: center;
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-image {
    width: 100%;
    max-width: 420px;
    justify-self: end;
  }

  .hero-image img {
    width: 100%;
    height: 180px;
    display: block;
    border-radius: 8px;
    object-fit: contain;
    object-position: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  @media (max-width: 640px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-image {
      max-width: 100%;
      justify-self: start;
    }

    .hero-image img {
      height: 160px;
    }
  }

  .part-stepper {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
    margin-bottom: 24px;
  }

  .part-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 0.78rem;
    padding: 6px 10px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    color: var(--color-text-muted);
    text-decoration: none;
    opacity: 0.7;
    transition: color 0.15s, border-color 0.15s, opacity 0.15s;
  }

  .part-step:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    opacity: 1;
  }

  .part-step-thumb {
    width: 56px;
    height: 40px;
    object-fit: contain;
    object-position: center;
    border-radius: 4px;
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .historical-note {
    margin-top: 8px;
  }

  .historical-note :global(p) {
    margin: 0 0 12px;
  }

  .historical-note :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: 12px 0;
  }

  .historical-note :global(ul),
  .historical-note :global(ol) {
    padding-left: 20px;
    margin: 12px 0;
  }

  .historical-note :global(li) {
    margin-bottom: 6px;
  }

  .build-part {
    border-top: 1px solid var(--color-border);
    padding-top: 32px;
    margin-top: 32px;
  }

  .build-part:first-child {
    border-top: none;
    margin-top: 0;
    padding-top: 0;
  }

  .build-part-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 20px;
  }

  .part-number {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .build-part-header h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .part-content img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: 12px 0;
  }

  .part-back {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px dashed var(--color-border);
  }

  .part-back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .part-back-link:hover {
    color: var(--color-primary);
  }

  .specs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin-top: 16px;
  }

  .spec-card {
    padding: 14px 16px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
  }

  .spec-card dt {
    margin: 0 0 6px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .spec-card dd {
    margin: 0;
    font-size: 1rem;
    color: var(--color-text);
  }

  .no-content {
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>