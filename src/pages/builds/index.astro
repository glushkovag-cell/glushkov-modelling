---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllModels } from '../../lib/wordpress';

const models = await getAllModels();
---
<BaseLayout title="Builds | Glushkov Modelling">
  <section class="page-section">
    <div class="container">
      <span class="eyebrow">Build Catalogue</span>
      <h1 class="section-title">Current and completed models</h1>

      <div class="builds-grid">
        {models.map((model: any) => (
          <article class="build-card">
            {model.heroImage && (
              <img
                src={model.heroImage}
                alt={model.heroImageAlt || model.title}
                loading="lazy"
                class="build-card-image"
              />
            )}

            <div class="build-card-body">
              <h2>{model.title}</h2>

              <p>
                Scale: {model.modelinfo?.modelscale || '&#8212;'} &#183; {model.modelinfo?.manufacturer || '&#8212;'}
              </p>

              {model.modelinfo?.shortdescription && (
                <p class="build-card-description">{model.modelinfo.shortdescription}</p>
              )}

              <div class="build-card-actions">
                {model.buildstatusText && (
                  <span class={`meta-pill status-${model.buildstatusClass}`}>
                    {model.buildstatusText}
                  </span>
                )}

                <a
                  class="build-link"
                  href={`/builds/${model.slug}`}
                >
                  Open build log &#8594;
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .build-card-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .build-link {
    display: inline-flex;
    align-items: center;
  }
</style>