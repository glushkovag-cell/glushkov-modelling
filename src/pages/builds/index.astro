---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getModelsWithFirstPart } from '../../lib/wordpress';

const models = await getModelsWithFirstPart();
---

<BaseLayout title="Builds | Glushkov Modelling">
  <section class="page-section">
    <div class="container">
      <span class="eyebrow">Build Catalogue</span>
      <h1 class="section-title">Current and completed models</h1>
      <div class="builds-grid">
        {models.map((model: any) => (
          <article class="build-card">
            {model.featuredImage?.node?.sourceUrl && (
              <img
                src={model.featuredImage.node.sourceUrl}
                alt={model.featuredImage.node.altText || model.title}
                loading="lazy"
              />
            )}
            <div class="build-card-body">
              <h2>{model.title}</h2>
              <p>
                Scale: {model.modelinfo?.modelscale || '—'} · {model.modelinfo?.manufacturer || '—'}
              </p>
              {model.modelinfo?.buildstatus && (
                <span class="meta-pill">{model.modelinfo.buildstatus}</span>
              )}
              <a
                class="build-link"
                href={model.firstPartSlug ? `/builds/${model.firstPartSlug}` : '/builds'}
              >
                Open build log →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>