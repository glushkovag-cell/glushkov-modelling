---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllModels, getAllNews, hasFreshNews } from '../../lib/wordpress';

const models = await getAllModels();

const allNews = await getAllNews();
const newsFlag = hasFreshNews(allNews);
---

<BaseLayout title="Builds | Glushkov Modelling" hasFreshNews={newsFlag}>
  <section class="page-section">
    <div class="container">
      <span class="eyebrow">Build Catalogue</span>
      <h1 class="section-title">Current and completed models</h1>

      <div class="builds-grid">
        {models.map((model: any) => (
            <div class="build-card card">
              <a
                  href={`/builds/${model.slug}`}
                  aria-label={`Open build log: ${model.title}`}
              >
                {model.heroImage && (
                    <img
                        src={model.heroImage}
                        alt={model.heroImageAlt || model.title}
                        loading="lazy"
                        class="build-card-image"
                    />
                )}

                <div class="build-card-body">
                  <h2>{model.title}</h2>

                  <p>
                    Scale: {model.modelinfo?.modelscale || '—'} · {model.modelinfo?.manufacturer || '—'}
                  </p>

                  {model.modelinfo?.shortdescription && (
                      <p class="build-card-description">{model.modelinfo.shortdescription}</p>
                  )}

                  <div class="build-card-actions">
                    {model.buildstatusText && (
                        <span class={`meta-pill status-${model.buildstatusClass}`}>
                      {model.buildstatusText}
                    </span>
                    )}
                  </div>
                </div>
              </a>
            </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .build-card-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .build-card > a {
    display: block;
    color: inherit;
  }

  .build-link {
    display: inline-flex;
    align-items: center;
  }
</style>
