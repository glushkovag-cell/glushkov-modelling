---
/**
 * BaseLayout.astro
 * Updated to support News nav item + fresh news badge.
 */
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  hasFreshNews?: boolean;
}

const {
  title = 'Glushkov Modelling',
  description = 'Virtual shipyard of a model ship builder',
  hasFreshNews = false,
} = Astro.props;

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
const wpRestUrl = import.meta.env.PUBLIC_WP_REST_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      href="https://api.fontshare.com/v2/css?f[]=cormorant@500,600,700&f[]=general-sans@400,500,600,700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />

    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body data-wp-rest-url={wpRestUrl}>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="Glushkov Modelling — Home">
          <img
            src="/logo_round.svg"
            alt="Glushkov Modelling logo"
            width="42"
            height="42"
            class="brand-logo"
            loading="eager"
          />
          <span class="brand-text">
            <strong>Glushkov Modelling</strong>
            <small>Virtual Shipyard</small>
          </span>
        </a>

        <nav class="nav" aria-label="Main navigation">
          <a href="/" class:list={['nav-link', { 'nav-link--active': isActive('/') }]}>
            Home
          </a>

          <a href="/about" class:list={['nav-link', { 'nav-link--active': isActive('/about') }]}>
            About
          </a>

          <a href="/builds" class:list={['nav-link', { 'nav-link--active': isActive('/builds') }]}>
            Builds
          </a>

          <a href="/gallery" class:list={['nav-link', { 'nav-link--active': isActive('/gallery') }]}>
            Gallery
          </a>

          <a href="/news" class:list={['nav-link', { 'nav-link--active': isActive('/news') }]}>
            <span>News</span>
            {hasFreshNews && <span class="nav-badge" aria-label="Fresh news available"></span>}
          </a>

          <a href="/tutorials" class:list={['nav-link', { 'nav-link--active': isActive('/tutorials') }]}>
            <span>Tutorials</span>
          </a>
        </nav>

        <button
          class="theme-toggle"
          aria-label="Switch to dark mode"
          data-theme-toggle
          title="Toggle theme"
        >
          <svg
            class="icon-sun"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="5" />
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
          </svg>

          <svg
            class="icon-moon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <script is:inline>
      (function () {
        const btn = document.querySelector('[data-theme-toggle]');
        const root = document.documentElement;

        function getTheme() {
          return root.getAttribute('data-theme') || 'light';
        }

        function applyTheme(theme) {
          root.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);

          if (btn) {
            btn.setAttribute(
              'aria-label',
              theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
            );
          }
        }

        if (btn) {
          btn.addEventListener('click', function () {
            applyTheme(getTheme() === 'dark' ? 'light' : 'dark');
          });
        }
      })();
    </script>
  </body>
</html>

<style>
  .nav-link {
    color: var(--color-text-muted);
    font-weight: 500;
    font-size: 0.95rem;
    transition: color var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .nav-link:hover {
    color: var(--color-primary);
  }

  .nav-link--active {
    color: var(--color-primary) !important;
  }

  .nav-badge {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--color-primary);
    display: inline-block;
    flex-shrink: 0;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 18%, transparent);
  }
</style>
