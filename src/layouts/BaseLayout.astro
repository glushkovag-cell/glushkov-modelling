---
/**
    * BaseLayout.astro
    * Updated to support News nav item + fresh news badge + responsive burger menu.
    */
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  hasFreshNews?: boolean;
}

const {
  title = 'Glushkov Modelling',
  description = 'Virtual shipyard of a model ship builder',
  hasFreshNews = false,
} = Astro.props;

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}

const wpRestUrl = import.meta.env.PUBLIC_WP_REST_URL;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <slot name="head" />
  <script is:inline>
    (function () {
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = stored || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>

<body data-wp-rest-url={wpRestUrl}>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Glushkov Modelling — Home">
      <img
          src="/logo_round.svg"
          alt="Glushkov Modelling logo"
          width="42"
          height="42"
          class="brand-logo"
          loading="eager"
      />
      <span class="brand-text">
            <strong>Glushkov Modelling</strong>
            <small>Virtual Shipyard</small>
          </span>
    </a>

    <nav class="nav" aria-label="Main navigation">
      <a href="/" class:list={['nav-link', { 'nav-link--active': isActive('/') }]}>Home</a>
      <a href="/about" class:list={['nav-link', { 'nav-link--active': isActive('/about') }]}>About</a>
      <a href="/builds" class:list={['nav-link', { 'nav-link--active': isActive('/builds') }]}>Builds</a>
      <a href="/gallery" class:list={['nav-link', { 'nav-link--active': isActive('/gallery') }]}>Gallery</a>
      <a href="/news" class:list={['nav-link', { 'nav-link--active': isActive('/news') }]}>
        <span>News</span>
        {hasFreshNews && <span class="nav-badge" aria-label="Fresh news available"></span>}
      </a>
      <a href="/tutorials" class:list={['nav-link', { 'nav-link--active': isActive('/tutorials') }]}>
        <span>Tutorials</span>
      </a>
    </nav>

    <div class="header-actions">
      <button
          class="theme-toggle"
          aria-label="Switch to dark mode"
          data-theme-toggle
          title="Toggle theme"
          type="button"
      >
        <svg
            class="icon-sun"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
        >
          <circle cx="12" cy="12" r="5" />
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
        </svg>
        <svg
            class="icon-moon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

      <button
          class="burger"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-burger
          type="button"
      >
        <span class="burger__line"></span>
        <span class="burger__line"></span>
        <span class="burger__line"></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation">
    <a href="/" class:list={['mobile-nav__link', { 'mobile-nav__link--active': isActive('/') }]}>Home</a>
    <a href="/about" class:list={['mobile-nav__link', { 'mobile-nav__link--active': isActive('/about') }]}>About</a>
    <a href="/builds" class:list={['mobile-nav__link', { 'mobile-nav__link--active': isActive('/builds') }]}>Builds</a>
    <a href="/gallery" class:list={['mobile-nav__link', { 'mobile-nav__link--active': isActive('/gallery') }]}>Gallery</a>
    <a href="/news" class:list={['mobile-nav__link', { 'mobile-nav__link--active': isActive('/news') }]}>
      <span>News</span>
      {hasFreshNews && <span class="nav-badge" aria-label="Fresh news available"></span>}
    </a>
    <a href="/tutorials" class:list={['mobile-nav__link', { 'mobile-nav__link--active': isActive('/tutorials') }]}>
      <span>Tutorials</span>
    </a>
  </nav>
</header>

<main>
  <slot />
</main>

<script is:inline>
  (function () {
    const btn = document.querySelector('[data-theme-toggle]');
    const root = document.documentElement;

    function getTheme() {
      return root.getAttribute('data-theme') || 'light';
    }

    function applyTheme(theme) {
      root.setAttribute('data-theme', theme);
      localStorage.setItem('theme', theme);
      if (btn) {
        btn.setAttribute(
            'aria-label',
            theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
        );
      }
    }

    if (btn) {
      btn.addEventListener('click', function () {
        applyTheme(getTheme() === 'dark' ? 'light' : 'dark');
      });
    }

    const burgerBtn = document.querySelector('[data-burger]');
    const mobileNav = document.getElementById('mobile-nav');

    function closeMobileMenu() {
      if (!burgerBtn || !mobileNav) return;
      burgerBtn.setAttribute('aria-expanded', 'false');
      burgerBtn.setAttribute('aria-label', 'Open navigation menu');
      burgerBtn.classList.remove('burger--open');
      mobileNav.classList.remove('mobile-nav--open');
    }

    function openMobileMenu() {
      if (!burgerBtn || !mobileNav) return;
      burgerBtn.setAttribute('aria-expanded', 'true');
      burgerBtn.setAttribute('aria-label', 'Close navigation menu');
      burgerBtn.classList.add('burger--open');
      mobileNav.classList.add('mobile-nav--open');
    }

    function toggleMobileMenu() {
      if (!burgerBtn || !mobileNav) return;
      const isOpen = burgerBtn.classList.contains('burger--open');
      if (isOpen) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    }

    if (burgerBtn && mobileNav) {
      closeMobileMenu();

      burgerBtn.addEventListener('click', toggleMobileMenu);

      mobileNav.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () {
          closeMobileMenu();
        });
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth > 920) {
          closeMobileMenu();
        }
      });
    }
  })();
</script>
</body>
</html>

<style>
  .header-actions {
    margin-left: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .nav-link {
    color: var(--color-text-muted);
    font-weight: 500;
    font-size: 0.95rem;
    transition: color var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .nav-link:hover {
    color: var(--color-primary);
  }

  .nav-link--active {
    color: var(--color-primary) !important;
  }

  .nav-badge {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--color-primary);
    display: inline-block;
    flex-shrink: 0;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 18%, transparent);
  }

  .burger {
    display: none;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text);
  }

  .burger__line {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
    transform-origin: center;
  }

  .burger--open .burger__line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .burger--open .burger__line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .burger--open .burger__line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    gap: 0;
    padding: 0.5rem 0 1rem;
    background: var(--color-surface);
    border-top: 1px solid var(--color-divider);
  }

  .mobile-nav.mobile-nav--open {
    display: flex;
  }

  .mobile-nav__link {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.75rem 1.25rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: color var(--transition), background var(--transition);
    border-radius: 0;
  }

  .mobile-nav__link:hover {
    color: var(--color-primary);
    background: var(--color-surface-2);
  }

  .mobile-nav__link--active {
    color: var(--color-primary) !important;
  }

  @media (max-width: 920px) {
    .nav {
      display: none;
    }

    .burger {
      display: flex;
    }
  }

  @media (min-width: 921px) {
    .mobile-nav {
      display: none !important;
    }
  }
</style>