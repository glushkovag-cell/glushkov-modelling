---
interface Props {
    selectedLevel: string;
}

const { selectedLevel = '' } = Astro.props;

const levels = [
    {
        value: 'beginner',
        label: 'Beginner',
    },
    {
        value: 'intermediate',
        label: 'Intermediate',
    },
    {
        value: 'advanced',
        label: 'Advanced',
    },
];

function getLevelHref(level: string): string {
    const params = new URLSearchParams(Astro.url.searchParams);

    if (level) {
        params.set('level', level);
    } else {
        params.delete('level');
    }

    const query = params.toString();

    return query
        ? `${Astro.url.pathname}?${query}`
        : Astro.url.pathname;
}
---

<nav
        class="level-filter"
        data-filter-type="level"
        aria-labelledby="level-filter-label"
>
    <div id="level-filter-label" class="filter-label">
        Level:
    </div>

    <div class="chip-group">
        <a
                class="chip chip-all"
                href={getLevelHref('')}
                data-selected={!selectedLevel}
                aria-current={!selectedLevel ? 'page' : undefined}
        >
            All
        </a>

        {levels.map((level) => {
            const selected = selectedLevel === level.value;

            return (
                    <a
                            class="chip"
                            href={getLevelHref(level.value)}
                            data-selected={selected}
                            aria-current={selected ? 'page' : undefined}
                    >
                        {level.label}
                    </a>
            );
        })}
    </div>
</nav>

<style>
    .level-filter {
        margin-bottom: 1.5rem;
    }

    .filter-label {
        margin-bottom: 0.75rem;
        color: var(--color-text);
        font-family: 'General Sans', sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .chip-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.75rem;
        padding: 0.5rem 1rem;
        border: 1px solid var(--color-text-muted);
        border-radius: 1.25rem;
        background: transparent;
        color: var(--color-text);
        font-family: 'General Sans', sans-serif;
        font-size: 0.875rem;
        line-height: 1;
        text-decoration: none;
        cursor: pointer;
        transition:
                color 0.2s ease,
                border-color 0.2s ease,
                background-color 0.2s ease;
    }

    .chip:hover {
        border-color: var(--color-primary);
    }

    .chip:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
    }

    .chip[data-selected='true'] {
        border-color: var(--color-primary);
        background: var(--color-primary);
        color: white;
    }

    @media (max-width: 768px) {
        .chip {
            padding: 0.4rem 0.8rem;
            font-size: 0.8rem;
        }
    }
</style>
