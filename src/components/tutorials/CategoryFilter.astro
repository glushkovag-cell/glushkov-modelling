---
import type { TutorialCategory } from '../../lib/wordpress';

interface Props {
    categories: TutorialCategory[];
    selectedSlugs: string[];
}

const { categories, selectedSlugs } = Astro.props;
---

<div class="category-filter" data-filter-type="category">
    <div class="filter-label">Categories:</div>
    <div class="chip-group">
        <button
                class="chip chip-all"
                data-slug="all"
                data-selected={selectedSlugs.length === 0}
                type="button"
        >
            All
        </button>
        {categories.map((category) => (
                <button
                        class="chip"
                        data-slug={category.slug}
                        data-selected={selectedSlugs.includes(category.slug)}
                        type="button"
                >
                    {category.name}
                </button>
        ))}
    </div>
</div>

<style>
    .category-filter {
        margin-bottom: 1.5rem;
    }

    .filter-label {
        font-family: 'General Sans', sans-serif;
        font-weight: 600;
        font-size: 0.875rem;
        margin-bottom: 0.75rem;
        color: var(--color-text);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .chip-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .chip {
        padding: 0.5rem 1rem;
        border-radius: 1.25rem;
        border: 1px solid var(--color-text-muted);
        background: transparent;
        color: var(--color-text);
        font-family: 'General Sans', sans-serif;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .chip:hover {
        border-color: var(--color-primary);
    }

    .chip[data-selected="true"] {
        background: var(--color-primary);
        color: white;
        border-color: var(--color-primary);
    }

    .chip-all[data-selected="true"] {
        background: var(--color-primary);
        color: white;
    }

    @media (max-width: 768px) {
        .chip {
            font-size: 0.8rem;
            padding: 0.4rem 0.8rem;
        }
    }
</style>
