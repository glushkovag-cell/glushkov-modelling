---
import type { NormalizedTutorial } from '../../lib/wordpress';

interface Props {
    tutorial: NormalizedTutorial;
}

const { tutorial } = Astro.props;
---

<article class="tutorial-card card">
    <a
            href={`/tutorials/${tutorial.slug}`}
            class="card-link"
            data-tutorial-link="true"
    >
        <h3>{tutorial.title}</h3>

        {tutorial.teaser && (
                <p class="teaser">{tutorial.teaser}</p>
        )}

        <div class="card-footer">
            {tutorial.level && (
                    <span class={`level-badge level-${String(tutorial.level).toLowerCase()}`}>
                    {tutorial.level}
                </span>
            )}
            {tutorial.categories.length > 0 && (
                    <div class="categories">
                        {tutorial.categories.slice(0, 2).map(cat => (
                                <span class="category-tag">{cat.name}</span>
                        ))}
                    </div>
            )}
        </div>
    </a>
</article>

<style>
    .tutorial-card {
        padding: 1.5rem;
    }

    .card-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    h3 {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.5rem;
        margin-bottom: 0.75rem;
        color: var(--color-text);
    }

    .teaser {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-footer {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .level-badge {
        padding: 0.375rem 0.75rem;
        border-radius: 1rem;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .level-beginner {
        background: #D4E8E9;
        color: var(--color-primary);
    }

    .level-intermediate {
        background: var(--color-primary);
        color: white;
    }

    .level-advanced {
        background: #014952;
        color: white;
    }

    .categories {
        display: flex;
        gap: 0.5rem;
    }

    .category-tag {
        font-size: 0.75rem;
        color: var(--color-text-muted);
    }
</style>
