---
/**
 * HiResViewer.astro
 *
 * Full-browser overlay component for immersive hi-res image inspection.
 * Drop this into any page that renders a gallery grid.
 *
 *
 * Public API:
 *   window.__viewer.open(slides, startIndex, trigger)
 *   window.__viewer.close()
 */
---

<div
  class="viewer-overlay"
  id="hiResViewer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="viewerTitle"
  hidden
>
  <div class="viewer-shell">
    <!-- Top bar -->
    <div class="viewer-topbar">
      <div class="viewer-topbar-row viewer-topbar-row--back">
        <button class="viewer-btn viewer-btn--primary" id="viewerClose" aria-label="Back to gallery">
          ← Back to gallery
        </button>
      </div>

      <div class="viewer-topbar-row viewer-topbar-row--title">
        <div class="viewer-title">
          <strong id="viewerTitle"></strong>
          <span id="viewerCaption"></span>
        </div>
      </div>

      <div class="viewer-topbar-row viewer-topbar-row--controls">
        <button class="viewer-btn viewer-btn--icon" id="viewerPrev" aria-label="Previous image">‹</button>
        <span class="viewer-counter" id="viewerCounter" aria-live="polite"></span>
        <button class="viewer-btn viewer-btn--icon" id="viewerNext" aria-label="Next image">›</button>
        <div class="viewer-divider" aria-hidden="true"></div>
        <button class="viewer-btn viewer-btn--icon" id="viewerZoomOut" aria-label="Zoom out">−</button>
        <button class="viewer-btn viewer-btn--zoom" id="viewerZoomReadout" aria-label="Current zoom level">100%</button>
        <button class="viewer-btn viewer-btn--icon" id="viewerZoomIn" aria-label="Zoom in">+</button>
        <button class="viewer-btn viewer-btn--desktop" id="viewerReset">Reset</button>
        <button class="viewer-btn viewer-btn--desktop" id="viewerFullscreen">Fullscreen</button>
      </div>
    </div>

    <!-- Stage -->
    <div class="viewer-stage" id="viewerStage">
      <div class="viewer-viewport" id="viewerViewport">
        <img
          id="viewerImage"
          class="viewer-image"
          src=""
          alt=""
          draggable="false"
        />
        <div class="viewer-loader" id="viewerLoader" aria-hidden="true"></div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="viewer-bottombar">
      <div class="viewer-hint">Hi-res viewer · 4K WebP source</div>
      <div class="viewer-shortcuts" aria-label="Keyboard shortcuts">
        <span>Wheel / pinch — zoom</span>
        <span>Drag — pan</span>
        <span><kbd>←</kbd><kbd>→</kbd> navigate</span>
        <span><kbd>Esc</kbd> close</span>
        <span><kbd>F</kbd> fullscreen</span>
        <span><kbd>0</kbd> reset</span>
      </div>
    </div>
  </div>
</div>

<style>
  .viewer-overlay,
  .viewer-shell,
  .viewer-stage,
  .viewer-viewport,
  .viewer-image {
    box-sizing: border-box;
  }

  .viewer-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: color-mix(in srgb, var(--color-bg) 86%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--color-text);
  }

  .viewer-overlay[hidden] {
    display: none;
  }

  .viewer-shell {
    position: absolute;
    inset: 12px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    border: 1px solid color-mix(in srgb, var(--color-border) 82%, transparent);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    box-shadow: var(--shadow-lg);
    min-width: 0;
    min-height: 0;
  }

  .viewer-topbar {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--color-divider);
    background:
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-surface) 98%, transparent),
        color-mix(in srgb, var(--color-surface-2) 92%, transparent)
      );
    color: var(--color-text);
  }

  .viewer-topbar-row {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .viewer-topbar-row--back {
    justify-content: flex-start;
  }

  .viewer-topbar-row--title {
    min-width: 0;
    overflow: hidden;
  }

  .viewer-topbar-row--controls {
    flex-wrap: wrap;
    justify-content: flex-start;
  }

  .viewer-title {
    min-width: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow: hidden;
  }

  .viewer-title strong {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .viewer-title span {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .viewer-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 36px;
    padding: 0 13px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface-2) 94%, transparent);
    color: var(--color-text);
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background var(--transition),
      border-color var(--transition),
      color var(--transition),
      transform var(--transition),
      box-shadow var(--transition);
  }

  .viewer-btn:hover {
    background: var(--color-primary-highlight);
    border-color: color-mix(in srgb, var(--color-primary) 45%, var(--color-border));
    color: var(--color-primary);
    transform: translateY(-1px);
  }

  .viewer-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .viewer-btn--primary {
    background: color-mix(in srgb, var(--color-primary) 14%, var(--color-surface));
    border-color: color-mix(in srgb, var(--color-primary) 34%, var(--color-border));
    color: var(--color-primary);
    font-weight: 600;
  }

  .viewer-btn--primary:hover {
    background: color-mix(in srgb, var(--color-primary) 22%, var(--color-surface));
    border-color: var(--color-primary);
    color: var(--color-primary-hover);
  }

  .viewer-btn--icon {
    width: 36px;
    padding: 0;
    font-size: 1.1rem;
  }

  .viewer-btn--zoom {
    min-width: 56px;
    font-variant-numeric: tabular-nums;
    font-size: 0.82rem;
  }

  .viewer-btn--desktop {
    display: inline-flex;
  }

  .viewer-btn:disabled {
    opacity: 0.38;
    cursor: not-allowed;
    transform: none;
  }

  .viewer-divider {
    width: 1px;
    height: 22px;
    background: var(--color-divider);
    margin: 0 4px;
  }

  .viewer-counter {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    min-width: 44px;
    text-align: center;
  }

  .viewer-stage {
    position: relative;
    overflow: hidden;
    display: block;
    padding: 20px 28px;
    background:
      radial-gradient(
        circle at top,
        color-mix(in srgb, var(--color-primary) 4%, transparent),
        transparent 38%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-surface-2) 96%, transparent),
        color-mix(in srgb, var(--color-surface-offset) 92%, transparent)
      );
    min-width: 0;
    min-height: 0;
  }

  .viewer-viewport {
    position: relative;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    touch-action: none;
  }

  .viewer-image {
    position: absolute;
    left: 50%;
    top: 50%;
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--color-border) 85%, transparent);
    background: var(--color-surface-2);
    box-shadow: var(--shadow-lg);
    transform-origin: center center;
    transition: transform 0.16s ease, opacity 0.2s ease;
    user-select: none;
    cursor: default;
    will-change: transform;
  }

  .viewer-image.is-draggable {
    cursor: grab;
  }

  .viewer-image.is-dragging {
    cursor: grabbing;
  }

  .viewer-image.is-loading {
    opacity: 0.45;
  }

  .viewer-loader {
    position: absolute;
    inset: 0;
    display: none;
    place-items: center;
    pointer-events: none;
  }

  .viewer-loader.is-active {
    display: grid;
  }

  .viewer-loader::after {
    content: '';
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--color-primary) 16%, var(--color-border));
    border-top-color: var(--color-primary);
    animation: spin 0.7s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .viewer-bottombar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 20px;
    border-top: 1px solid var(--color-divider);
    background:
      linear-gradient(
        to top,
        color-mix(in srgb, var(--color-surface) 98%, transparent),
        color-mix(in srgb, var(--color-surface-2) 92%, transparent)
      );
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .viewer-hint {
    color: var(--color-text-muted);
  }

  .viewer-shortcuts {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    margin: 0 2px;
    border-radius: 5px;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface-2) 96%, transparent);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    font-family: inherit;
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 900px) {
    .viewer-shell {
      inset: 8px;
    }

    .viewer-topbar {
      padding: 12px 14px;
      gap: 10px;
    }

    .viewer-topbar-row--controls {
      justify-content: flex-start;
    }

    .viewer-title strong,
    .viewer-title span {
      max-width: 100%;
    }
  }

  @media (max-width: 700px) {
    .viewer-shortcuts {
      display: none;
    }

    .viewer-stage {
      padding: 8px;
    }

    .viewer-btn {
      height: 34px;
      padding: 0 11px;
      font-size: 0.82rem;
    }

    .viewer-btn--icon {
      width: 34px;
    }

    .viewer-topbar {
      padding: 10px 12px;
      gap: 8px;
    }

    .viewer-title strong {
      font-size: 1rem;
    }

    .viewer-title span {
      font-size: 0.78rem;
    }

    .viewer-btn--desktop {
      display: none;
    }

    .viewer-divider {
      margin: 0 2px;
    }
  }

  @media (min-width: 901px) {
    .viewer-topbar {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 16px;
      padding: 14px 20px;
    }

    .viewer-topbar-row--back,
    .viewer-topbar-row--title,
    .viewer-topbar-row--controls {
      display: flex;
      align-items: center;
      min-width: 0;
    }

    .viewer-topbar-row--title {
      overflow: hidden;
    }

    .viewer-topbar-row--controls {
      justify-content: flex-end;
      flex-wrap: wrap;
    }

    .viewer-title {
      width: auto;
    }
  }
</style>

<script>
  (() => {
    let slides = [];
    let currentIndex = 0;
    let scale = 1;
    let translateX = 0;
    let translateY = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let lastTrigger = null;

    const MIN_SCALE = 0.5;
    const MAX_SCALE = 5;
    const ZOOM_STEP = 0.25;
    const WHEEL_STEP = 0.10;

    const overlay = document.getElementById('hiResViewer');
    const img = document.getElementById('viewerImage');
    const loader = document.getElementById('viewerLoader');
    const titleEl = document.getElementById('viewerTitle');
    const captionEl = document.getElementById('viewerCaption');
    const counterEl = document.getElementById('viewerCounter');
    const zoomReadout = document.getElementById('viewerZoomReadout');

    const btnClose = document.getElementById('viewerClose');
    const btnPrev = document.getElementById('viewerPrev');
    const btnNext = document.getElementById('viewerNext');
    const btnZoomIn = document.getElementById('viewerZoomIn');
    const btnZoomOut = document.getElementById('viewerZoomOut');
    const btnReset = document.getElementById('viewerReset');
    const btnFullscreen = document.getElementById('viewerFullscreen');

    const clamp = (v, lo, hi) => Math.min(hi, Math.max(lo, v));

    function updateTransform() {
      img.style.transform = `translate3d(-50%, -50%, 0) translate3d(${translateX}px, ${translateY}px, 0) scale(${scale})`;
      zoomReadout.textContent = `${Math.round(scale * 100)}%`;
      const draggable = scale > 1;
      img.classList.toggle('is-draggable', draggable && !isDragging);
      img.classList.toggle('is-dragging', isDragging);
    }

    function resetView() {
      scale = 1;
      translateX = 0;
      translateY = 0;
      isDragging = false;
      updateTransform();
    }

    function zoomBy(delta) {
      scale = clamp(scale + delta, MIN_SCALE, MAX_SCALE);
      if (scale <= 1) {
        translateX = 0;
        translateY = 0;
      }
      updateTransform();
    }

    function updateNav() {
      btnPrev.disabled = currentIndex === 0;
      btnNext.disabled = currentIndex === slides.length - 1;
      counterEl.textContent = slides.length > 1 ? `${currentIndex + 1} / ${slides.length}` : '';
    }

    function loadSlide(index) {
      if (index < 0 || index >= slides.length) return;
      currentIndex = index;
      const slide = slides[index];

      titleEl.textContent = slide.title || '';
      captionEl.textContent = slide.caption || '';
      updateNav();

      img.classList.add('is-loading');
      loader.classList.add('is-active');

      img.onload = null;
      img.onerror = null;

      img.src = slide.src;
      img.alt = slide.caption || slide.title || '';

      img.onload = () => {
        img.classList.remove('is-loading');
        loader.classList.remove('is-active');
        resetView();
      };

      img.onerror = () => {
        img.classList.remove('is-loading');
        loader.classList.remove('is-active');
      };
    }

    function openViewer(allSlides, startIndex, trigger) {
      slides = Array.isArray(allSlides) ? allSlides : [];
      lastTrigger = trigger ?? null;
      if (!slides.length) return;

      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      loadSlide(startIndex ?? 0);
      btnClose.focus();
    }

    function closeViewer() {
      overlay.hidden = true;
      document.body.style.overflow = '';
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      if (lastTrigger instanceof HTMLElement) lastTrigger.focus();
    }

    function prevSlide() {
      if (currentIndex > 0) loadSlide(currentIndex - 1);
    }

    function nextSlide() {
      if (currentIndex < slides.length - 1) loadSlide(currentIndex + 1);
    }

    btnClose.addEventListener('click', closeViewer);
    btnPrev.addEventListener('click', prevSlide);
    btnNext.addEventListener('click', nextSlide);
    btnZoomIn.addEventListener('click', () => zoomBy(ZOOM_STEP));
    btnZoomOut.addEventListener('click', () => zoomBy(-ZOOM_STEP));
    btnReset.addEventListener('click', resetView);

    btnFullscreen.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        overlay.requestFullscreen && overlay.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen && document.exitFullscreen().catch(() => {});
      }
    });

    overlay.addEventListener('wheel', (e) => {
      e.preventDefault();
      zoomBy(e.deltaY < 0 ? WHEEL_STEP : -WHEEL_STEP);
    }, { passive: false });

    img.addEventListener('mousedown', (e) => {
      if (scale <= 1) return;
      isDragging = true;
      startX = e.clientX - translateX;
      startY = e.clientY - translateY;
      updateTransform();
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      translateX = e.clientX - startX;
      translateY = e.clientY - startY;
      updateTransform();
    });

    window.addEventListener('mouseup', () => {
      if (!isDragging) return;
      isDragging = false;
      updateTransform();
    });

    let touchStartX = 0;
    overlay.addEventListener('touchstart', (e) => {
      if (!e.touches.length) return;
      touchStartX = e.touches[0].clientX;
    }, { passive: true });

    overlay.addEventListener('touchend', (e) => {
      if (!e.changedTouches.length) return;
      const delta = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(delta) > 50 && scale <= 1) {
        if (delta < 0) nextSlide();
        else prevSlide();
      }
    }, { passive: true });

    window.addEventListener('keydown', (e) => {
      if (overlay.hidden) return;
      switch (e.key) {
        case 'Escape': closeViewer(); break;
        case 'ArrowLeft': prevSlide(); break;
        case 'ArrowRight': nextSlide(); break;
        case '+':
        case '=': zoomBy(ZOOM_STEP); break;
        case '-': zoomBy(-ZOOM_STEP); break;
        case '0': resetView(); break;
        case 'f':
        case 'F': btnFullscreen.click(); break;
      }
    });

    window.__viewer = {
      open: openViewer,
      close: closeViewer,
      openViewer,
      closeViewer,
    };

    document.addEventListener('gallery:open', (e) => {
      const detail = e.detail || {};
      openViewer(detail.slides, detail.index ?? 0, detail.trigger ?? null);
    });
  })();
</script>