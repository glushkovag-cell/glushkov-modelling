---
interface Props {
    rootSelector: string;
    titleAttr?: string;
    itemTitleBuilder?: 'build-part' | 'single-title';
    globalKey?: string;
    zoomCursor?: boolean;
}

const {
    rootSelector,
    titleAttr = 'data-part-title',
    itemTitleBuilder = 'single-title',
    globalKey = '__contentMediaViewerBridgeInit',
    zoomCursor = true,
} = Astro.props;
---

<div
        data-media-viewer-bridge
        data-root-selector={rootSelector}
        data-title-attr={titleAttr}
        data-item-title-builder={itemTitleBuilder}
        data-global-key={globalKey}
        data-zoom-cursor={zoomCursor ? 'true' : 'false'}
></div>

<script is:inline>
    (() => {
        const bridges = Array.from(document.querySelectorAll('[data-media-viewer-bridge]'));
        if (!bridges.length) return;

        const IMAGE_EXT_RE = /\.(?:avif|gif|jpe?g|png|webp)(?:[?#].*)?$/i;

        function isWpMediaFileLink(href) {
            if (!href) return false;

            try {
                const url = new URL(href, window.location.href);
                return url.pathname.includes('/wp-content/uploads/') && IMAGE_EXT_RE.test(url.pathname);
            } catch {
                return false;
            }
        }

        function buildItemTitle(block, titleAttr, itemTitleBuilder) {
            const baseTitle = block.getAttribute(titleAttr) || '';

            if (itemTitleBuilder === 'build-part') {
                const partNumber = block.getAttribute('data-part-number') || '';
                return baseTitle
                    ? `Part ${partNumber} — ${baseTitle}`
                    : `Part ${partNumber || ''}`.trim();
            }

            return baseTitle || document.title || '';
        }

        function applyZoomCursor(rootSelector) {
            const roots = Array.from(document.querySelectorAll(rootSelector));

            roots.forEach((root) => {
                const links = root.querySelectorAll('a[href]');
                links.forEach((anchor) => {
                    if (!(anchor instanceof HTMLAnchorElement)) return;
                    if (!isWpMediaFileLink(anchor.getAttribute('href') || '')) return;

                    const img = anchor.querySelector('img');
                    if (!(img instanceof HTMLImageElement)) return;

                    img.style.cursor = 'zoom-in';
                });
            });
        }

        function initBridge(configNode) {
            const globalKey = configNode.dataset.globalKey || '__contentMediaViewerBridgeInit';
            if (window[globalKey]) return;
            window[globalKey] = true;

            const rootSelector = configNode.dataset.rootSelector;
            const titleAttr = configNode.dataset.titleAttr || 'data-part-title';
            const itemTitleBuilder = configNode.dataset.itemTitleBuilder || 'single-title';
            const zoomCursor = configNode.dataset.zoomCursor === 'true';

            if (!rootSelector) return;

            function getEntries() {
                const blocks = Array.from(document.querySelectorAll(rootSelector));

                return blocks.flatMap((block) => {
                    const itemTitle = buildItemTitle(block, titleAttr, itemTitleBuilder);

                    return Array.from(block.querySelectorAll('a[href]'))
                        .map((anchor) => {
                            if (!(anchor instanceof HTMLAnchorElement)) return null;

                            const img = anchor.querySelector('img');
                            const href = anchor.getAttribute('href') || '';

                            if (!(img instanceof HTMLImageElement)) return null;
                            if (!isWpMediaFileLink(href)) return null;

                            return {
                                anchor,
                                slide: {
                                    src: href,
                                    title: itemTitle,
                                    caption:
                                        img.getAttribute('alt') ||
                                        img.getAttribute('title') ||
                                        itemTitle ||
                                        '',
                                },
                            };
                        })
                        .filter(Boolean);
                });
            }

            if (zoomCursor) {
                applyZoomCursor(rootSelector);
                document.addEventListener('astro:page-load', () => applyZoomCursor(rootSelector));
            }

            document.addEventListener(
                'click',
                (event) => {
                    const target = event.target;
                    if (!(target instanceof Element)) return;

                    const anchor = target.closest(`${rootSelector} a[href]`);
                    if (!(anchor instanceof HTMLAnchorElement)) return;

                    const img = anchor.querySelector('img');
                    if (!(img instanceof HTMLImageElement)) return;

                    const href = anchor.getAttribute('href') || '';
                    if (!isWpMediaFileLink(href)) return;

                    const viewer = window.__viewer;
                    if (!viewer || typeof viewer.open !== 'function') return;

                    const entries = getEntries();
                    if (!entries.length) return;

                    const index = entries.findIndex((entry) => entry.anchor === anchor);
                    if (index === -1) return;

                    event.preventDefault();
                    event.stopPropagation();

                    viewer.open(
                        entries.map((entry) => entry.slide),
                        index,
                        anchor
                    );
                },
                true
            );
        }

        bridges.forEach(initBridge);
    })();
</script>