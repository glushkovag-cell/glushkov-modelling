---
import type { NewsItem, NewsType, ExternalSource } from '../../lib/wordpress';

interface Props {
  items: NewsItem[];
}

const { items } = Astro.props;

const TYPE_LABELS: Record<NewsType, string> = {
  'announcement': 'Announcement',
  'social-release': 'Social release',
  'build-log-entry': 'Build log',
  'new-model': 'New model',
  'new-tutorial': 'Tutorial',
  'site-update': 'Website update',
};

const SOURCE_LABELS: Record<ExternalSource, string> = {
  'internal': 'Site',
  'youtube': 'YouTube',
  'telegram': 'Telegram',
  'instagram': 'Instagram',
  'facebook': 'Facebook',
};

const formatPublishedDate = (value: string) =>
  new Date(value).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });

const formatEventDate = (value: string) =>
  new Date(value).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
---

{items.length === 0 ? (
  <div class="news-list-empty">
    <p class="news-list-empty__title">No news for the last twelve months.</p>
    <p class="news-list-empty__text">
      New updates, releases, model pages, and workshop announcements will appear here as they are published.
    </p>
  </div>
) : (
  <ul class="news-list" role="list">
    {items.map((item) => (
      <li class={`news-list__item${item.news.isPinned ? ' news-list__item--pinned' : ''}`}>
        <div class="news-list__topline">
          <div class="news-list__meta">
            <time class="news-list__date" datetime={item.date}>
              {formatPublishedDate(item.date)}
            </time>

            <span class="news-list__separator">—</span>

            <span class={`news-list__type news-list__type--${item.news.newsType}`}>
              {TYPE_LABELS[item.news.newsType] ?? item.news.newsType}
            </span>

            {item.news.isPinned && (
              <>
                <span class="news-list__separator">•</span>
                <span class="news-list__pinned">Pinned</span>
              </>
            )}

            {item.news.externalSource && item.news.externalSource !== 'internal' && (
              <>
                <span class="news-list__separator">•</span>
                <span class="news-list__source">
                  {SOURCE_LABELS[item.news.externalSource] ?? item.news.externalSource}
                </span>
              </>
            )}
          </div>
        </div>

        <div class="news-list__content">
          <a href={`/news/${item.slug}`} class="news-list__title">
            {item.title}
          </a>

          <p class="news-list__text">
            {item.news.shortText}
          </p>

          {item.news.newsType === 'announcement' && item.news.eventDate && (
            <p class="news-list__event">
              Event date: <time datetime={item.news.eventDate}>{formatEventDate(item.news.eventDate)}</time>
            </p>
          )}

          {item.news.relatedModel && (
            <p class="news-list__related">
              Related model:{' '}
              <a href={`/builds/${item.news.relatedModel.slug}`}>
                {item.news.relatedModel.title}
              </a>
            </p>
          )}

          <div class="news-list__actions">
            <a href={`/news/${item.slug}`} class="news-list__more">
              Open entry
            </a>

            <a
              href={item.news.targetUrl}
              class="news-list__cta"
              target="_blank"
              rel="noopener noreferrer"
            >
              {item.news.targetLabel}
            </a>
          </div>
        </div>
      </li>
    ))}
  </ul>
)}

<style>
  .news-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .news-list__item {
    padding: 18px 20px;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    background: var(--color-surface);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.03);
  }

  .news-list__item--pinned {
    border-color: color-mix(in srgb, var(--color-primary) 32%, var(--color-border));
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.035),
      0 0 0 1px color-mix(in srgb, var(--color-primary) 10%, transparent) inset;
  }

  .news-list__topline {
    margin-bottom: 10px;
  }

  .news-list__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 0.86rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .news-list__date {
    color: var(--color-text-muted);
  }

  .news-list__separator {
    color: var(--color-text-faint, var(--color-text-muted));
  }

  .news-list__type {
    color: var(--color-text);
    font-weight: 600;
  }

  .news-list__pinned {
    color: var(--color-primary);
    font-weight: 600;
  }

  .news-list__source {
    color: var(--color-text-muted);
  }

  .news-list__title {
    display: inline-block;
    margin: 0 0 8px;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-text);
    text-decoration: none;
  }

  .news-list__title:hover {
    color: var(--color-primary);
  }

  .news-list__text {
    margin: 0 0 8px;
    color: var(--color-text-muted);
    line-height: 1.55;
    max-width: 72ch;
  }

  .news-list__event,
  .news-list__related {
    margin: 0 0 8px;
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .news-list__related a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .news-list__related a:hover {
    text-decoration: underline;
  }

  .news-list__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 12px;
    align-items: center;
  }

  .news-list__more,
  .news-list__cta {
    text-decoration: none;
    font-weight: 600;
  }

  .news-list__more {
    color: var(--color-text);
  }

  .news-list__more:hover {
    color: var(--color-primary);
  }

  .news-list__cta {
    color: var(--color-primary);
  }

  .news-list__cta:hover {
    text-decoration: underline;
  }

  .news-list-empty {
    padding: 28px 24px;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    background: var(--color-surface);
  }

  .news-list-empty__title {
    margin: 0 0 8px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .news-list-empty__text {
    margin: 0;
    color: var(--color-text-muted);
    max-width: 62ch;
    line-height: 1.55;
  }

  @media (min-width: 900px) {
    .news-list {
      gap: 18px;
    }

    .news-list__item {
      padding: 20px 22px;
    }
  }
</style>