{
	"name": "mcp-registry-badge",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-14",
	"observability": {
		"enabled": true
	},
	"workers_dev": false,
	"routes": [
		{
			"pattern": "mcp-badge.glushkov-modelling.com",
			"custom_domain": true
		}
	],
	"vars": {
		"MCP_SERVER_NAME": "com.glushkov-modelling/content",
		"CACHE_TTL_SECONDS": "3600",
		"MCP_FALLBACK_VERSION": "1.3.1"
	}
}
