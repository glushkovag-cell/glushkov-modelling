{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.glushkov-modelling.com/api/rigging/schema/profile-document.schema.json",
  "title": "Rigging profile document",
  "description": "Versioned rigging-diameter profile. Coefficients and role selection live in data, not in code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentVersion",
    "profile",
    "rules"
  ],
  "properties": {
    "documentVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "material": {
      "enum": [
        "fiber",
        "wire",
        "rod",
        "chain",
        "unknown"
      ]
    },
    "tier": {
      "enum": [
        "lower",
        "topmast",
        "topgallant"
      ]
    },
    "sailClass": {
      "enum": [
        "head_lower",
        "head_upper",
        "staysail_lower",
        "staysail_upper"
      ]
    },
    "nodeType": {
      "enum": [
        "lower_mast",
        "topmast",
        "topgallant",
        "yard",
        "fore_and_aft_sail",
        "gaff",
        "gaff_sail",
        "boom",
        "main_sail",
        "topsail",
        "head_lower",
        "head_upper",
        "staysail",
        "flag",
        "lateen_yard",
        "bowsprit",
        "jibboom",
        "flying_jibboom",
        "martingale",
        "spritsail_yard",
        "hull_group",
        "anchor_group",
        "gun_group"
      ]
    },
    "group": {
      "enum": [
        "standing",
        "running",
        "bowsprit",
        "anchor",
        "gun"
      ]
    },
    "coefficientBasis": {
      "enum": [
        "engineering_assumption",
        "preliminary_fit"
      ]
    },
    "calibrationStatus": {
      "enum": [
        "not_calibrated",
        "training_set_only"
      ]
    },
    "reasonCode": {
      "enum": [
        "node_absent",
        "sail_not_configured",
        "rule_not_supported",
        "material_not_supported",
        "installation_not_supported",
        "configuration_required",
        "measurement_required",
        "dependency_unavailable"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "locator"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "profileVersion",
        "schemaVersion",
        "family",
        "status",
        "name",
        "yearFrom",
        "yearTo",
        "bases",
        "baseLabels",
        "materialConditions",
        "sources",
        "warnings",
        "ui"
      ],
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "profileVersion": {
          "$ref": "#/$defs/semver"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "published",
            "deprecated"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "yearFrom": {
          "type": [
            "integer",
            "null"
          ]
        },
        "yearTo": {
          "type": [
            "integer",
            "null"
          ]
        },
        "bases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mast",
            "bowsprit",
            "hullWidth",
            "gunBore",
            "thickestMast"
          ],
          "properties": {
            "mast": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "bowsprit": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "hullWidth": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "gunBore": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "thickestMast": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "baseLabels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mast",
            "bowsprit",
            "hullWidth",
            "gunBore",
            "thickestMast"
          ],
          "properties": {
            "mast": {
              "type": "string",
              "minLength": 1
            },
            "bowsprit": {
              "type": "string",
              "minLength": 1
            },
            "hullWidth": {
              "type": "string",
              "minLength": 1
            },
            "gunBore": {
              "type": "string",
              "minLength": 1
            },
            "thickestMast": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "baseFactorLabels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mast": {
              "type": "string"
            },
            "bowsprit": {
              "type": "string"
            },
            "hullWidth": {
              "type": "string"
            },
            "gunBore": {
              "type": "string"
            },
            "thickestMast": {
              "type": "string"
            }
          }
        },
        "materialConditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/material"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "masts",
            "tiers",
            "yards",
            "squareSails",
            "foreAndAft",
            "lateenYard",
            "gaff",
            "gaffSail",
            "boom",
            "mainSail",
            "topsail",
            "headSails",
            "staysail",
            "flag",
            "bowsprit",
            "spritsaill",
            "jibboom",
            "martingale",
            "anchor",
            "hullGroup",
            "gun",
            "mastPoint",
            "bowspritPoint"
          ],
          "properties": {
            "masts": {
              "type": "boolean"
            },
            "tiers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tier"
              }
            },
            "yards": {
              "type": "boolean"
            },
            "squareSails": {
              "type": "boolean"
            },
            "foreAndAft": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sailClass"
              }
            },
            "lateenYard": {
              "type": "boolean"
            },
            "gaff": {
              "type": "boolean"
            },
            "gaffSail": {
              "type": "boolean"
            },
            "boom": {
              "type": "boolean"
            },
            "mainSail": {
              "type": "boolean"
            },
            "topsail": {
              "type": "boolean"
            },
            "headSails": {
              "type": "boolean"
            },
            "staysail": {
              "type": "boolean"
            },
            "flag": {
              "type": "boolean"
            },
            "bowsprit": {
              "type": "boolean"
            },
            "spritsaill": {
              "type": "boolean"
            },
            "jibboom": {
              "type": "boolean"
            },
            "martingale": {
              "type": "boolean"
            },
            "anchor": {
              "type": "boolean"
            },
            "hullGroup": {
              "type": "boolean"
            },
            "gun": {
              "type": "boolean"
            },
            "mastPoint": {
              "enum": [
                "partner",
                "maximum",
                "step",
                "unknown"
              ]
            },
            "bowspritPoint": {
              "enum": [
                "working_section",
                "unknown"
              ]
            },
            "defaults": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "scaleDenominator": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "mastDiameterMm": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "fore": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "main": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "mizzen": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                },
                "bowspritDiameterMm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "hullWidthMm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "gunBoreMm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "anchor": {
                  "type": "boolean"
                },
                "gaff": {
                  "type": "boolean"
                },
                "spritsaill": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "metrics": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "note"
          ],
          "properties": {
            "fittedRoles": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "mapePercent": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "maxDeviationPercent": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "crossTransferMapePercent": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "crossTransferMaxPercent": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "cardNote": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "role",
        "name",
        "group",
        "select",
        "base",
        "factor",
        "materials",
        "coefficientBasis",
        "calibrationStatus",
        "sources"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "ropeId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "ru"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "ru": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "group": {
          "$ref": "#/$defs/group"
        },
        "select": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeType"
          ],
          "properties": {
            "nodeType": {
              "$ref": "#/$defs/nodeType"
            },
            "tier": {
              "anyOf": [
                {
                  "$ref": "#/$defs/tier"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sailClass": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sailClass"
                },
                {
                  "type": "null"
                }
              ]
            },
            "perMast": {
              "type": "boolean"
            }
          }
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "present": {
              "type": "boolean"
            },
            "sailPresent": {
              "type": "boolean"
            },
            "supportedGunMounting": {
              "type": "boolean"
            }
          }
        },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "mast",
                "bowsprit",
                "hullWidth",
                "gunBore",
                "thickestMast",
                "rule"
              ]
            },
            "ruleId": {
              "type": "string",
              "minLength": 1
            },
            "nodeType": {
              "$ref": "#/$defs/nodeType"
            },
            "tier": {
              "anyOf": [
                {
                  "$ref": "#/$defs/tier"
                },
                {
                  "type": "null"
                }
              ]
            },
            "scope": {
              "enum": [
                "own",
                "fore",
                "thickest",
                "supporting"
              ]
            }
          }
        },
        "factor": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "factorLabel": {
          "type": "string",
          "minLength": 1
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/material"
          }
        },
        "material": {
          "$ref": "#/$defs/material"
        },
        "materialInvariance": {
          "type": "boolean"
        },
        "coefficientBasis": {
          "$ref": "#/$defs/coefficientBasis"
        },
        "calibrationStatus": {
          "$ref": "#/$defs/calibrationStatus"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupportedWhen": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "equals",
              "reason"
            ],
            "properties": {
              "field": {
                "enum": [
                  "anchorConnection",
                  "gunType",
                  "mountingType",
                  "material"
                ]
              },
              "equals": {
                "type": "string"
              },
              "reason": {
                "$ref": "#/$defs/reasonCode"
              }
            }
          }
        },
        "alternativeGroupId": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "enum": [
            "compound",
            "simple"
          ]
        },
        "perMastOverrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fore": {
              "$ref": "#/$defs/basisOverride"
            },
            "main": {
              "$ref": "#/$defs/basisOverride"
            },
            "mizzen": {
              "$ref": "#/$defs/basisOverride"
            }
          }
        }
      }
    },
    "basisOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coefficientBasis": {
          "$ref": "#/$defs/coefficientBasis"
        },
        "calibrationStatus": {
          "$ref": "#/$defs/calibrationStatus"
        }
      }
    }
  }
}
