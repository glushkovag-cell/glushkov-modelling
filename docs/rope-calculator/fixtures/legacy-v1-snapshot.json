{
  "schema": 1,
  "description": "Legacy rope calculator contract before load-aware algorithm 3.0.0.",
  "catalogVersion": "0b24290aff0e",
  "contract": {
    "apiVersion": "1",
    "algorithmVersion": "2.0.0",
    "routes": [
      "/api/rope/v1/health",
      "/api/rope/v1/catalog",
      "/api/rope/v1/forward",
      "/api/rope/v1/reverse"
    ],
    "formula": "0.0204055952 * dtex^0.5293147610 * n^0.5366123919",
    "threadsPerStrand": [
      1,
      2,
      3,
      4,
      5
    ],
    "customDtex": {
      "min": 80,
      "max": 6000
    },
    "reverseTolerance": 0.15,
    "forwardRequest": {
      "catalog": {
        "basis": "catalog",
        "threadId": "string",
        "threadsPerStrand": "1..5"
      },
      "dtex": {
        "basis": "dtex",
        "dtex": "80..6000",
        "threadsPerStrand": "1..5"
      }
    },
    "forwardResponse": [
      "apiVersion",
      "algorithmVersion",
      "catalogVersion",
      "fetchedAt",
      "basis",
      "input",
      "result"
    ],
    "forwardResult": [
      "basis",
      "threadId",
      "dtex",
      "threadsPerStrand",
      "strands",
      "construction",
      "diameterMm"
    ],
    "reverseRequest": {
      "targetDiameterMm": "> 0",
      "threadIds": "string[] | absent"
    },
    "reverseResponse": [
      "apiVersion",
      "algorithmVersion",
      "catalogVersion",
      "fetchedAt",
      "input",
      "results"
    ],
    "reverseMatch": [
      "threadId",
      "brand",
      "number",
      "dtex",
      "threadsPerStrand",
      "construction",
      "diameterMm",
      "deviationPercent"
    ],
    "reverseSort": [
      "|deviation|",
      "dtex",
      "threadsPerStrand",
      "sortOrder",
      "threadId"
    ]
  },
  "mcp": {
    "calculate_rope_diameter": {
      "input": {
        "basis": "'catalog' | 'dtex'",
        "threadId": "string?",
        "dtex": "number 80..6000?",
        "threadsPerStrand": "int 1..5"
      },
      "output": [
        "basis",
        "threadId",
        "dtex",
        "diameterMm",
        "threadsPerStrand",
        "strands",
        "construction",
        "catalogVersion",
        "apiVersion",
        "algorithmVersion"
      ],
      "rounding": "none: Worker numbers are passed through"
    },
    "find_rope_threads": {
      "input": {
        "targetDiameterMm": "number > 0",
        "threadIds": "string[]?"
      },
      "output": [
        "targetDiameterMm",
        "tolerancePercent",
        "totalMatched",
        "catalogVersion",
        "apiVersion",
        "algorithmVersion",
        "results"
      ],
      "rounding": "none: Worker numbers are passed through"
    }
  },
