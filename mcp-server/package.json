{
  "name": "glushkov-modelling-mcp-server",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "MCP-сервер (Model Context Protocol) для доступа AI-ассистентов к данным сайта glushkov-modelling.com через WPGraphQL и файловую систему галереи.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node build/index.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "graphql": "^16.9.0",
    "graphql-request": "^7.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
