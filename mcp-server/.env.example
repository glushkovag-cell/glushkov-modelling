# Ключ для авторизации входящих MCP-запросов (Authorization: Bearer <MCP_API_KEY>)
MCP_API_KEY=

# Список разрешённых значений заголовка Origin, через запятую (защита от DNS rebinding)
# Пример: https://www.perplexity.ai,https://perplexity.ai
MCP_ALLOWED_ORIGINS=

# Публичный origin сайта — база для канонических абсолютных URL, которые
# read-инструменты возвращают в поле url (src/lib/public-urls.ts).
# В dev/preview укажите соответствующий домен, иначе ссылки будут вести в production.
PUBLIC_SITE_URL=https://www.glushkov-modelling.com

# Эндпоинт WPGraphQL сайта
WP_GRAPHQL_URL=https://cms.glushkov-modelling.com/graphql

# Секретный заголовок X-GraphQL-Secret (та же переменная, что и у Astro-сайта) —
# без него Cloudflare/WAF возвращает 404 на любые запросы к /graphql
WP_GRAPHQL_SECRET=

# Application Password read-only технического пользователя WordPress (логин:пароль в base64 либо отдельные поля)
WP_READONLY_USERNAME=
WP_READONLY_APP_PASSWORD=

# Корневой каталог галереи на файловой системе VPS (manifest.json на постройку + index/models.json)
GALLERY_MANIFEST_PATH=/var/www/cms/gallery

# Публичный базовый URL, по которому раздаётся GALLERY_MANIFEST_PATH (та же переменная,
# что использует Astro-сайт в src/lib/gallery.ts, для сборки ссылок на изображения)
CMS_GALLERY_URL=

# Хост и порт, на которых слушает процесс (только localhost — внешний трафик идёт через Nginx)
HOST=127.0.0.1
PORT=4322

# OAuth 2.1 для нового маршрута /mcp-oauth.
# Старый /mcp продолжает работать через MCP_API_KEY.
OAUTH_ISSUER=https://auth.glushkov-modelling.com/realms/public-mcp
OAUTH_JWKS_URI=https://auth.glushkov-modelling.com/realms/public-mcp/protocol/openid-connect/certs
OAUTH_AUDIENCE=https://mcp.glushkov-modelling.com/mcp-oauth
OAUTH_REQUIRED_SCOPE=content:read
OAUTH_RESOURCE_METADATA_URI=https://mcp.glushkov-modelling.com/.well-known/oauth-protected-resource/mcp-oauth
